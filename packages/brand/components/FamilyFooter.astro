---
/**
 * Footer for an HLLMR family site (ADR-0015 D4, D5): the provenance strip with the site's arms; the
 * company (a division names its parent, HLLMR Ventures LLC); the contact route with this site's
 * subject line; the site's index; the other family sites; then the colophon with the site revision
 * (the last commit touching what the site shows, so an unchanged rebuild stays byte-identical).
 */
import { COMPANY, DIVISION_SITES, mailto, type DivisionSite } from "@hllmr/portfolio";
import ProvenanceStrip from "./ProvenanceStrip.astro";

interface Props {
  site: DivisionSite;
  nav: readonly { href: string; label: string }[];
  /** Short name of this page for the colophon's "sheet". */
  sheet: string;
  revision: { date: string; hash: string };
}
const { site, nav, sheet, revision } = Astro.props;
const year = revision.date === "unreleased" ? "2026" : revision.date.slice(0, 4);
const isParent = site.key === "vntrs";
const others = DIVISION_SITES.filter((d) => d.key !== site.key);
---

<footer class="ft">
  <div class="wrap">
    <div class="cols">
      <div class="col maker">
        <ProvenanceStrip coat={site.coat} label={site.label} />
        <p class="org">
          {isParent ? COMPANY.owner : site.name}<br /><span>{isParent ? COMPANY.locality : `A division of ${COMPANY.owner}`}</span>
        </p>
      </div>
      <div class="col">
        <span class="anno">Contact</span>
        <a class="mail" href={mailto(site.subject)}>{COMPANY.email}</a>
        <a class="muted" href={COMPANY.github} rel="noopener">github.com/HLLMR</a>
        <a class="muted" href={COMPANY.founderUrl}>Founder: dhellmer.com</a>
      </div>
      <nav class="col index" aria-label="Footer">
        <span class="anno">Index</span>
        <ul>
          <li><a href="/">Home</a></li>
          {
            nav.map((l) => (
              <li>
                <a href={l.href}>{l.label}</a>
              </li>
            ))
          }
          <li><a href="/privacy/">Privacy</a></li>
        </ul>
      </nav>
      <nav class="col family" aria-label="Other HLLMR sites">
        <span class="anno">HLLMR</span>
        <ul>
          {
            others.map((d) => (
              <li>
                <a href={`${d.origin}/`}>{d.key === "vntrs" ? "HLLMR Ventures" : d.name}</a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
    <p class="fine">
      <span>© {year} {COMPANY.owner}. Self-hosted, no cookies, no trackers.</span>
      <span>{sheet} · rev {revision.date} <a href={COMPANY.siteSource} rel="noopener">{revision.hash}</a></span>
    </p>
  </div>
</footer>

<style>
  .ft {
    margin-top: var(--space-8);
    border-top: 2px solid var(--text);
  }
  .cols {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr) minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-6);
    padding: var(--space-6) 0;
  }
  .col {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
  }
  .maker {
    gap: var(--space-4);
  }
  .org {
    margin: 0;
    font-weight: 600;
    font-size: 0.95rem;
  }
  .org span {
    font-weight: 400;
    color: var(--muted);
  }
  .mail {
    font-weight: 600;
    text-decoration: none;
    overflow-wrap: anywhere;
  }
  .muted {
    color: var(--muted);
    font-size: 0.9rem;
    text-decoration: none;
  }
  .index ul,
  .family ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .index ul {
    columns: 2;
    column-gap: 16px;
  }
  .index li,
  .family li {
    font-size: 0.92rem;
    line-height: 1.8;
  }
  .index a,
  .family a {
    color: var(--text);
    text-decoration: none;
  }
  .index a:hover,
  .family a:hover {
    color: var(--primary);
    text-decoration: underline;
  }
  .fine {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 6px 24px;
    margin: 0;
    padding: var(--space-4) 0 var(--space-6);
    border-top: 1px solid var(--rule);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.04em;
    color: var(--muted);
  }
  .fine a {
    color: var(--muted);
  }
  @media (max-width: 860px) {
    .cols {
      grid-template-columns: 1fr 1fr;
    }
    .maker {
      grid-column: 1 / -1;
    }
  }
</style>
