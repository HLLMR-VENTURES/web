---
/**
 * The privacy notice shared by every HLLMR family site. It must match what the sites and their host
 * actually do (ADR-0011, ADR-0015 D5): no cookies, trackers, forms or third-party requests; proxy
 * access logs kept up to about five weeks (weekly rotation, 4 generations; confirmed by Claude
 * (infra) 2026-10-18), counted per site in aggregate for the owner only.
 */
import { COMPANY, type DivisionSite } from "@hllmr/portfolio";

interface Props {
  site: DivisionSite;
  themeKey: string;
}
const { site, themeKey } = Astro.props;
const host = new URL(site.origin).host;
---

<section class="section">
  <div class="wrap prose">
    <h2>What this site does not do</h2>
    <ul>
      <li>No cookies, no analytics scripts, no tracking pixels, no advertising.</li>
      <li>No third-party requests: fonts, styles and images are all served from {host}.</li>
      <li>No forms. Nothing you do on the site is sent anywhere by the site.</li>
    </ul>

    <h2>What the server records</h2>
    <p>
      Like any web server, ours writes an access log entry for each request: the time, the page, the response, the
      referring page, your browser's user-agent string and your IP address. We use these logs to keep the site running
      and secure, and to count requests. Access logs are kept for up to about five weeks, then deleted.
    </p>
    <p>
      Those counts are aggregate (for example, requests per page per day). The IP addresses are not kept in the counts,
      and the counts are visible only to {COMPANY.owner}. We do not sell or share log data.
    </p>

    <h2>Your theme choice</h2>
    <p>
      If you use the light/dark toggle, your choice is saved in your browser's local storage under the key
      <code>{themeKey}</code>, for this site only. It never leaves your browser and you can clear it at any time.
    </p>

    <h2>Where it is hosted</h2>
    <p>
      {host} is one of the HLLMR sites run by {COMPANY.owner}. It is self-hosted on servers in Germany, with backups and
      a recovery copy in North America.
    </p>

    <h2>Email</h2>
    <p>
      If you email us, we keep the message to reply and to run the business, in our own mail system. We do not add you
      to any list.
    </p>

    <h2>Questions</h2>
    <p><a href={`mailto:${COMPANY.email}`}>{COMPANY.email}</a></p>
  </div>
</section>
