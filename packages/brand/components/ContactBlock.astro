---
/**
 * The contact section of a family site: one mailto with the site's subject line, the address shown
 * as text beside it (owner decision 2026-10-18: email only, nothing sent by the site).
 */
import { COMPANY, mailto, type DivisionSite } from "@hllmr/portfolio";

interface Props {
  site: DivisionSite;
  heading: string;
  text: string;
  button: string;
}
const { site, heading, text, button } = Astro.props;
---

<section class="section contact" id="contact">
  <div class="wrap contact-in">
    <div>
      <h2>{heading}</h2>
      <p>{text}</p>
    </div>
    <div class="go">
      <a class="btn btn-primary" href={mailto(site.subject)}>{button}</a>
      <p class="addr">{COMPANY.email} · subject "{site.subject}"</p>
    </div>
  </div>
</section>

<style>
  .contact-in {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: var(--space-6);
    align-items: center;
  }
  h2 {
    font-size: var(--text-2xl);
    margin: 0 0 var(--space-3);
  }
  p {
    margin: 0;
    color: var(--muted);
    max-width: 56ch;
  }
  .go {
    display: grid;
    gap: var(--space-2);
    justify-items: start;
  }
  .addr {
    font-family: var(--font-mono);
    font-size: 0.78rem;
  }
  @media (max-width: 760px) {
    .contact-in {
      grid-template-columns: 1fr;
    }
  }
</style>
