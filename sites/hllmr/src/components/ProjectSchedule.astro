---
/** The project schedule, drawn as an equipment schedule: tag, project, what it is, status, links. */
import type { Project } from "@hllmr/portfolio";
import { here } from "../lib/site";

interface Props {
  projects: Project[];
  caption?: string;
}
const { projects, caption } = Astro.props;
---

<table class="schedule proj">
  {caption && <caption class="anno">{caption}</caption>}
  <thead>
    <tr>
      <th scope="col">Tag</th>
      <th scope="col">Project</th>
      <th scope="col">Description</th>
      <th scope="col">Status</th>
      <th scope="col">Refs</th>
    </tr>
  </thead>
  <tbody>
    {
      projects.map((p) => (
        <tr id={p.slug}>
          <td class="tag">{p.tag}</td>
          <td class="name">
            {p.page ? <a href={here(p.page)}>{p.name}</a> : <span>{p.name}</span>}
            <span class="kind anno">{p.kind}</span>
          </td>
          <td>
            <p class="what">{p.what}</p>
            <p class="sum">{p.summary}</p>
          </td>
          <td class="status">{p.status}</td>
          <td class="refs">
            {p.page && <a href={here(p.page)}>{here(p.page) === "/writwall/" ? "page" : "case study"}</a>}
            {p.links.map((l) => (
              <a href={l.href} rel="noopener">
                {l.label}
              </a>
            ))}
            {!p.page && p.links.length === 0 && <span class="muted">not public yet</span>}
          </td>
        </tr>
      ))
    }
  </tbody>
</table>

<style>
  .name {
    min-width: 11rem;
  }
  .name a,
  .name span:first-child {
    font-family: var(--font-ui);
    font-weight: 650;
    font-size: 1.08rem;
    line-height: 1.2;
  }
  .name a {
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: var(--rule);
  }
  .name a:hover {
    text-decoration-color: var(--primary);
  }
  .kind {
    display: block;
    margin-top: 6px;
  }
  .what {
    font-weight: 600;
  }
  .sum {
    color: var(--muted);
    font-size: 0.9rem;
    margin-top: 4px !important;
  }
  .status {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    min-width: 8.5rem;
  }
  .refs {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    min-width: 8rem;
  }
  .refs a,
  .refs span {
    display: block;
    line-height: 1.9;
  }
  .muted {
    color: var(--muted);
  }
  tr:target {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }
</style>
