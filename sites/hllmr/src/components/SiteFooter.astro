---
/**
 * Footer: the provenance strip (maker, the venture's arms, office, date letter), the company, the
 * contact route and the index; then the colophon line with the site revision (last commit touching
 * the site, so an unchanged rebuild stays byte-identical).
 */
import ProvenanceStrip from "@hllmr/brand/components/ProvenanceStrip.astro";
import { CONTACT_EMAIL, LINKS, LOCALITY, NAV, OWNER, REVISION } from "../lib/site";

interface Props {
  sheet: string;
  skin?: "hub" | "build";
}
const { sheet, skin = "hub" } = Astro.props;
const year = REVISION.date === "unreleased" ? "2026" : REVISION.date.slice(0, 4);
---

<footer class="ft">
  <div class="wrap">
    <div class="cols">
      <div class="col maker">
        <ProvenanceStrip coat={skin === "build" ? "build" : "house"} label={skin === "build" ? "Build" : "Ventures"} />
        <p class="org">{OWNER}<br /><span>{LOCALITY}</span></p>
      </div>
      <div class="col">
        <span class="anno">Contact</span>
        <a class="mail" href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
        <a class="muted" href={LINKS.github} rel="noopener">github.com/HLLMR-VENTURES</a>
        <a class="muted" href={LINKS.founder}>Founder: dhellmer.com</a>
      </div>
      <nav class="col index" aria-label="Footer">
        <span class="anno">Index</span>
        <ul>
          <li><a href="/">Home</a></li>
          <li><a href="/build/">Build</a></li>
          {
            NAV.map((l) => (
              <li>
                <a href={l.href}>{l.label}</a>
              </li>
            ))
          }
          <li><a href="/privacy/">Privacy</a></li>
        </ul>
      </nav>
    </div>
    <p class="fine">
      <span>© {year} {OWNER}. Self-hosted, no cookies, no trackers.</span>
      <span>{sheet} · rev {REVISION.date} <a href={LINKS.siteSource} rel="noopener">{REVISION.hash}</a></span>
    </p>
  </div>
</footer>

<style>
  .ft {
    margin-top: var(--space-8);
    border-top: 2px solid var(--text);
  }
  .cols {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-6);
    padding: var(--space-6) 0;
  }
  .col {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
  }
  .maker {
    gap: var(--space-4);
  }
  .org {
    margin: 0;
    font-weight: 600;
    font-size: 0.95rem;
  }
  .org span {
    font-weight: 400;
    color: var(--muted);
  }
  .mail {
    font-weight: 600;
    text-decoration: none;
    overflow-wrap: anywhere;
  }
  .muted {
    color: var(--muted);
    font-size: 0.9rem;
    text-decoration: none;
    overflow-wrap: anywhere;
  }
  .index ul {
    list-style: none;
    margin: 0;
    padding: 0;
    columns: 2;
    column-gap: 16px;
  }
  .index li {
    font-size: 0.92rem;
    line-height: 1.8;
  }
  .index a {
    color: var(--text);
    text-decoration: none;
  }
  .index a:hover {
    color: var(--primary);
    text-decoration: underline;
  }
  .fine {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 6px 24px;
    margin: 0;
    padding: var(--space-4) 0 var(--space-6);
    border-top: 1px solid var(--rule);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.04em;
    color: var(--muted);
  }
  .fine a {
    color: var(--muted);
  }
  @media (max-width: 760px) {
    .cols {
      grid-template-columns: 1fr 1fr;
    }
    .maker {
      grid-column: 1 / -1;
    }
  }
</style>
