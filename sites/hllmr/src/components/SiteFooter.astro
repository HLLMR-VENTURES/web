---
/**
 * Footer drawn as a drawing title block: owner, sheet (this page), revision (last commit touching
 * the site), contact and the sheet index (site links).
 */
import Wordmark from "./Wordmark.astro";
import { CONTACT_EMAIL, LINKS, LOCALITY, NAV, OWNER, REVISION } from "../lib/site";

interface Props {
  sheet: string;
}
const { sheet } = Astro.props;
const year = REVISION.date === "unreleased" ? "2026" : REVISION.date.slice(0, 4);
---

<footer class="ft">
  <div class="wrap">
    <div class="tb" role="group" aria-label="Title block">
      <div class="cell owner">
        <span class="anno">Owner</span>
        <a class="brand" href="/" aria-label="HLLMR Ventures, home"><Wordmark /></a>
        <span class="v">{OWNER}</span>
        <span class="muted">{LOCALITY}</span>
      </div>
      <div class="cell">
        <span class="anno">Sheet</span>
        <span class="v">{sheet}</span>
      </div>
      <div class="cell">
        <span class="anno">Rev</span>
        <span class="v mono">{REVISION.date}</span>
        <a class="muted mono" href={LINKS.siteSource} rel="noopener">{REVISION.hash}</a>
      </div>
      <div class="cell">
        <span class="anno">Contact</span>
        <a class="v" href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
        <a class="muted" href={LINKS.github} rel="noopener">github.com/HLLMR</a>
      </div>
      <nav class="cell index" aria-label="Footer">
        <span class="anno">Sheet index</span>
        <ul>
          <li><a href="/">Home</a></li>
          {
            NAV.map((l) => (
              <li>
                <a href={l.href}>{l.label}</a>
              </li>
            ))
          }
          <li><a href="/privacy/">Privacy</a></li>
        </ul>
      </nav>
    </div>
    <p class="fine">
      © {year}
      {OWNER}. Self-hosted, no cookies, no trackers. Built with AI agents and checked by a person.
    </p>
  </div>
</footer>

<style>
  .ft {
    margin-top: var(--space-8);
    padding-bottom: var(--space-6);
  }
  .tb {
    display: grid;
    grid-template-columns: 1.4fr 1fr 0.8fr 1.2fr 1.3fr;
    border: 1.5px solid var(--text);
    background: var(--surface);
  }
  .cell {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 12px 14px;
    border-left: 1px solid var(--rule);
    min-width: 0;
  }
  .cell:first-child {
    border-left: 0;
  }
  .brand {
    text-decoration: none;
    margin: 4px 0 8px;
  }
  .v {
    font-weight: 650;
    font-size: 0.95rem;
    overflow-wrap: anywhere;
  }
  .mono {
    font-family: var(--font-mono);
    font-size: 0.78rem;
  }
  .muted {
    color: var(--muted);
    font-size: 0.85rem;
  }
  a.v,
  a.muted {
    text-decoration: none;
  }
  a.v {
    color: var(--primary);
  }
  .index ul {
    list-style: none;
    margin: 0;
    padding: 0;
    columns: 2;
    column-gap: 12px;
  }
  .index li {
    font-size: 0.88rem;
    line-height: 1.7;
  }
  .index a {
    color: var(--text);
    text-decoration: none;
  }
  .index a:hover {
    color: var(--primary);
    text-decoration: underline;
  }
  .fine {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.04em;
    color: var(--muted);
    margin: var(--space-3) 0 0;
  }
  @media (max-width: 900px) {
    .tb {
      grid-template-columns: 1fr 1fr;
    }
    .cell {
      border-left: 0;
      border-top: 1px solid var(--rule);
    }
    .cell:first-child {
      border-top: 0;
    }
    .cell:first-child,
    .cell:nth-child(4),
    .cell.index {
      grid-column: 1 / -1;
    }
    .cell:nth-child(3) {
      border-left: 1px solid var(--rule);
    }
  }
</style>
