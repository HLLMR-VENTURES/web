---
/**
 * Home: HLLMR Ventures, shown as VNTRS (ADR-0015). The parent company that owns the HLLMR name
 * and runs four divisions, each on its own site. Direction 2, identity first (owner decision
 * 2026-10-20): the name, then the company, then the four doors of equal standing, with UPGRADE
 * holding the one paid call to action.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import Arms from "@hllmr/brand/components/Arms.astro";
import Wordmark from "@hllmr/brand/components/Wordmark.astro";
import { ARMS, type ArmsKey } from "@hllmr/brand/arms";
import VentureRegister, { type RegisterRow } from "../components/VentureRegister.astro";
import { DIVISION_SITES, PROJECTS, PROJECT_STAGE, WRITING, mailto } from "@hllmr/portfolio";
import { CONTACT_EMAIL, FOUNDER, LINKS, LOCALITY, OWNER, abs, here } from "../lib/site";

const site = Astro.site;
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": abs("/#organization", site),
      name: OWNER,
      alternateName: "HLLMR",
      url: abs("/", site),
      logo: abs("/favicon.png", site),
      email: CONTACT_EMAIL,
      founder: { "@type": "Person", name: FOUNDER, url: LINKS.founder },
      sameAs: [LINKS.github],
    },
    {
      "@type": "WebSite",
      "@id": abs("/#website", site),
      name: "HLLMR Ventures",
      url: abs("/", site),
      publisher: { "@id": abs("/#organization", site) },
    },
  ],
};

const divisions = DIVISION_SITES.filter((d) => d.key !== "vntrs");
const projects: RegisterRow[] = PROJECTS.map((p) => ({
  slug: p.slug,
  name: p.name,
  field: p.kind,
  line: p.what,
  stage: PROJECT_STAGE[p.slug] ?? "Building",
  href: p.page ? here(p.page) : `/projects/#${p.slug}`,
  links: p.links,
}));
const essay = WRITING[0]!;
const cycle: ArmsKey[] = ["house", "tools", "upgrade", "live", "gaming"];
const roll: ArmsKey[] = [...cycle, ...cycle, ...cycle, ...cycle];
---

<BaseLayout
  title="HLLMR · Software, business systems, music and games"
  description="HLLMR Ventures LLC owns the HLLMR name and runs four divisions: TOOLS for software, UPGRADE for business systems, LIVE for music and media, and GAMING for games and mods."
  sheet="Home"
  jsonLd={jsonLd}
>
  <section class="hero">
    <div class="wrap hero-in">
      <div class="copy">
        <p class="meta anno">
          <span>{OWNER}</span><span>{LOCALITY}</span><span>Est. 2026</span>
        </p>
        <h1><span class="visually-hidden">HLLMR</span><Wordmark height={88} class="hero-wm" decorative /></h1>
        <p class="lede">
          One name across software, business systems, music and games. HLLMR Ventures owns it and runs each line as its own
          division, built and shown working before it is called done.
        </p>
      </div>
      <figure class="house">
        <Arms coat="house" size={220} />
        <figcaption>{ARMS.house.blazon}</figcaption>
      </figure>
    </div>
    <div class="roll" aria-hidden="true">
      {roll.map((k) => <Arms coat={k} size={72} form="banner" decorative />)}
    </div>
    <div class="wrap roll-cap">
      <span class="anno">The roll of arms</span><span class="anno">House · Tools · Upgrade · Live · Gaming</span>
    </div>
  </section>

  <section class="section" id="divisions" aria-labelledby="divisions-h">
    <div class="wrap">
      <div class="head">
        <h2 id="divisions-h">Four divisions</h2>
        <p class="count anno">Each on its own site</p>
      </div>
      <ul class="doors">
        {
          divisions.map((d) => (
            <li class:list={["door", { lead: d.key === "upgrade" }]}>
              <a class="door-name" href={`${d.origin}/`}>
                <Arms coat={d.coat} size={48} decorative />
                <span>
                  <span class="wm-name">HLLMR <span class="desc">{d.descriptor}</span></span>
                  {d.field.toUpperCase() !== d.descriptor && <span class="field anno">{d.field}</span>}
                </span>
              </a>
              <p>{d.line}</p>
              {d.key === "upgrade" ? (
                <a class="btn btn-primary" href={mailto(d.subject)}>
                  Request an assessment
                </a>
              ) : (
                <a class="go" href={`${d.origin}/`}>
                  {new URL(d.origin).host} →
                </a>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="projects-h">
    <div class="wrap">
      <div class="head">
        <h2 id="projects-h">The register</h2>
        <p class="count anno"><a href="/projects/">Divisions and projects →</a></p>
      </div>
      <VentureRegister rows={projects} label="Projects" size="sm" />
    </div>
  </section>

  <section class="section" aria-labelledby="path-h">
    <div class="wrap">
      <div class="head">
        <h2 id="path-h">How a venture grows</h2>
      </div>
      <ol class="path">
        <li>
          <span class="n anno">01 · Idea</span>
          <h3>Start here</h3>
          <p>An idea gets a line in the register. Nothing more until it earns it.</p>
        </li>
        <li>
          <span class="n anno">02 · Building</span>
          <h3>Prove it</h3>
          <p>It is built and tested in the open, with its limits written down next to its claims.</p>
        </li>
        <li>
          <span class="n anno">03 · Launched</span>
          <h3>Its own front door</h3>
          <p>A launched venture gets its own name, look and address, like silo.hllmr.com.</p>
        </li>
        <li>
          <span class="n anno">04 · Spun out</span>
          <h3>Its own company</h3>
          <p>When it outgrows the house, it can become its own company. The register keeps the link.</p>
        </li>
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="writing-h">
    <div class="wrap two">
      <div>
        <p class="anno">Writing · {essay.kind}</p>
        <h2 id="writing-h"><a href={here(essay.path)}>{essay.title}</a></h2>
      </div>
      <p class="muted">{essay.description} <a href="/writing/">All writing →</a></p>
    </div>
  </section>

  <section class="section contact" aria-labelledby="contact-h">
    <div class="wrap two">
      <h2 id="contact-h">Get in touch.</h2>
      <div>
        <p class="muted">
          A partnership, a project, a booking or a question. One address reaches a person. Founded and run by {FOUNDER};
          background and writing at <a href={LINKS.founder}>dhellmer.com</a>.
        </p>
        <p><a class="btn btn-primary" href="/contact/">{CONTACT_EMAIL}</a></p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding: var(--space-8) 0 0;
  }
  .hero-in {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    gap: clamp(28px, 5vw, 72px);
    align-items: end;
    padding-bottom: var(--space-7);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 22px;
    margin: 0 0 var(--space-5);
  }
  .hero h1 {
    margin: 0;
    line-height: 1;
  }
  .hero h1 :global(.hero-wm .wm-svg) {
    width: min(390px, 78vw);
    height: auto;
  }
  .lede {
    margin: var(--space-5) 0 0;
    font-size: var(--text-lg);
    color: var(--muted);
    max-width: 46ch;
  }
  .house {
    margin: 0;
    justify-self: end;
    display: grid;
    justify-items: center;
    gap: 14px;
  }
  .house :global(.arms) {
    width: min(220px, 48vw);
    height: auto;
  }
  .house figcaption {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.15rem;
  }
  .roll {
    display: flex;
    overflow: hidden;
    border-block: 1px solid var(--rule);
  }
  .roll :global(.arms) {
    flex: 0 0 auto;
  }
  .roll-cap {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    padding-top: 10px;
  }
  @media (max-width: 760px) {
    .hero-in {
      grid-template-columns: 1fr;
    }
    .house {
      justify-self: start;
    }
  }

  .head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-4);
  }
  .head h2 {
    font-size: var(--text-3xl);
  }
  .count {
    margin: 0;
  }

  .doors {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr));
    gap: var(--space-4);
  }
  .door {
    background: var(--surface);
    border: 1px solid var(--border);
    border-top: 2px solid var(--text);
    padding: var(--space-5);
    display: grid;
    gap: var(--space-3);
    align-content: start;
    min-width: 0;
  }
  .door.lead {
    border: 2px solid var(--primary);
  }
  .door-name {
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--text);
    text-decoration: none;
  }
  .door-name > span {
    display: grid;
    gap: 2px;
  }
  .wm-name {
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: 1.1rem;
    letter-spacing: 0.02em;
  }
  .desc {
    font-family: var(--font-ui);
    font-stretch: 125%;
    font-weight: 500;
    font-size: 0.78rem;
    letter-spacing: 0.2em;
    padding-left: 6px;
    border-left: 1px solid var(--rule);
  }
  .field {
    font-size: 0.64rem;
  }
  .door p {
    margin: 0;
    color: var(--muted);
  }
  .go {
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }
  .door .btn {
    justify-self: start;
  }

  .path {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 2px solid var(--text);
  }
  .path li {
    padding: var(--space-4) var(--space-4) var(--space-2) 0;
  }
  .path li + li {
    border-left: 1px solid var(--rule);
    padding-left: var(--space-4);
  }
  .path h3 {
    margin: var(--space-2) 0;
  }
  .path p {
    margin: 0;
    color: var(--muted);
  }
  @media (max-width: 900px) {
    .path {
      grid-template-columns: 1fr 1fr;
    }
    .path li:nth-child(3) {
      border-left: 0;
      padding-left: 0;
    }
    .path li:nth-child(n + 3) {
      border-top: 1px solid var(--rule);
    }
  }
  @media (max-width: 520px) {
    .path {
      grid-template-columns: 1fr;
    }
    .path li + li {
      border-left: 0;
      padding-left: 0;
      border-top: 1px solid var(--rule);
    }
  }

  .two {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(24px, 5vw, 72px);
    align-items: start;
  }
  .two h2 {
    font-size: var(--text-2xl);
  }
  .muted {
    color: var(--muted);
    margin: 0 0 var(--space-4);
  }
  @media (max-width: 760px) {
    .two {
      grid-template-columns: 1fr;
    }
  }
</style>
