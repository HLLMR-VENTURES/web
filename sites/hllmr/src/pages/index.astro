---
/** Home: the proposition, two equal doors (build for a business / help a team), the work, the
 * method, the writing and the contact route. */
import BaseLayout from "../layouts/BaseLayout.astro";
import Wordmark from "../components/Wordmark.astro";
import ProjectSchedule from "../components/ProjectSchedule.astro";
import { PROJECTS } from "../lib/projects";
import { CONTACT_EMAIL, FOUNDER, LINKS, OWNER, abs } from "../lib/site";

const site = Astro.site;
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": abs("/#organization", site),
      name: OWNER,
      alternateName: "HLLMR",
      url: abs("/", site),
      logo: abs("/favicon.png", site),
      email: CONTACT_EMAIL,
      founder: { "@type": "Person", name: FOUNDER },
      sameAs: [LINKS.github],
    },
    {
      "@type": "WebSite",
      "@id": abs("/#website", site),
      name: "HLLMR",
      url: abs("/", site),
      publisher: { "@id": abs("/#organization", site) },
    },
  ],
};
const silo = PROJECTS[0]!;
---

<BaseLayout
  title="HLLMR Ventures · Software, commissioned"
  description="HLLMR Ventures builds software and automation with AI agents, and proves it works before calling it done. We build for businesses and help teams adopt AI-assisted development with discipline."
  sheet="General"
  jsonLd={jsonLd}
>
  <section class="hero">
    <div class="wrap">
      <div class="sheet">
        <div class="zones top" aria-hidden="true"><span>1</span><span>2</span><span>3</span><span>4</span><span>5</span><span>6</span></div>
        <div class="zones side" aria-hidden="true"><span>A</span><span>B</span><span>C</span><span>D</span></div>
        <div class="sheet-in">
          <p class="anno reveal r1">HLLMR Ventures LLC · DWG G-001 · General</p>
          <h1 class="reveal r2">
            Software, <span class="mark">commissioned.<span class="callout anno anno-red" aria-hidden="true">built, then witnessed working</span></span>
          </h1>
          <p class="lede reveal r3">
            We build software and automation with AI agents, and we prove it works before we call it done. The speed is
            real. So is the habit agents have of reporting work finished when it isn't. We bring the second discipline
            to the first.
          </p>
          <div class="ctas reveal r4">
            <a class="btn btn-primary" href="/contact/">Start a conversation</a>
            <a class="btn btn-ghost" href="/projects/">See the work</a>
          </div>
          <div class="big-mark reveal r5" aria-hidden="true"><Wordmark size="lg" /></div>
        </div>
      </div>
    </div>
  </section>

  <section class="section doors" aria-labelledby="doors-h">
    <div class="wrap">
      <div class="section-head">
        <p class="anno">Two ways in</p>
        <h2 id="doors-h">What we do</h2>
      </div>
      <div class="door-grid">
        <a class="door" href="/services/#build">
          <span class="anno anno-red">Detail A</span>
          <h3>Build it for us</h3>
          <p>
            For a business that needs software, an internal tool or an automation built and kept running. We scope it with
            you, build it with AI agents under review, test it against what you asked for, and hand over something you can
            run and audit.
          </p>
          <span class="go">Building with HLLMR →</span>
        </a>
        <a class="door" href="/services/#teams">
          <span class="anno anno-red">Detail B</span>
          <h3>Help our team do it</h3>
          <p>
            For an engineering team already using AI coding agents. We set up the guardrails that keep agent work
            honest: bounded work, explicit permissions, independent review, controls tested before they are trusted, and
            a record a new person can follow.
          </p>
          <span class="go">Working with your team →</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section featured" aria-labelledby="featured-h">
    <div class="wrap feat-grid">
      <div>
        <p class="anno">Featured · {silo.tag}</p>
        <h2 id="featured-h">{silo.name}</h2>
        <p class="feat-what">{silo.what}</p>
        <p>{silo.summary}</p>
        <div class="ctas">
          <a class="btn btn-primary" href="/projects/silo/">Read the case study</a>
          <a class="btn btn-ghost" href={LINKS.silo}>Visit silo.hllmr.com</a>
        </div>
      </div>
      <dl class="spec">
        <dt>Status</dt><dd>{silo.status}</dd>
        <dt>License</dt><dd>MIT, source on GitHub</dd>
        <dt>Platforms</dt><dd>Windows (code-signed), macOS and Linux preview</dd>
        <dt>Stack</dt><dd>Rust and Tauri desktop app, Svelte UI, Node API, Postgres</dd>
        <dt>Runs on</dt><dd>The HLLMR self-hosted stack, released through the same approvals as everything else</dd>
      </dl>
    </div>
  </section>

  <section class="section" aria-labelledby="work-h">
    <div class="wrap">
      <div class="section-head">
        <p class="anno">Project schedule</p>
        <h2 id="work-h">The work</h2>
        <p>Products, infrastructure, methods and libraries. Most of it is public, so you can check it.</p>
      </div>
      <ProjectSchedule projects={PROJECTS} />
    </div>
  </section>

  <section class="section method" aria-labelledby="method-h">
    <div class="wrap">
      <div class="section-head">
        <p class="anno">Sequence of operations</p>
        <h2 id="method-h">How we work</h2>
        <p>
          The method comes from twenty years of commissioning building systems, where nobody accepts a damper because the
          submittal says it closes.
        </p>
      </div>
      <ol class="seq">
        <li>
          <span class="n">01</span>
          <h3>Intent, written and approved</h3>
          <p>What the system is for, decided by a person and kept in the record, not in anyone's memory or chat history.</p>
        </li>
        <li>
          <span class="n">02</span>
          <h3>Bounded work</h3>
          <p>Agents work one scoped unit at a time, with explicit limits on what they may touch.</p>
        </li>
        <li>
          <span class="n">03</span>
          <h3>Witnessed test</h3>
          <p>Every claim is checked by running it. Rollback is exercised before a release is approved, not after it fails.</p>
        </li>
        <li>
          <span class="n">04</span>
          <h3>A record you keep</h3>
          <p>Decisions, with the alternatives that were rejected, stay with the work, so the next person can judge the next change.</p>
        </li>
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="writing-h">
    <div class="wrap writing">
      <div>
        <p class="anno">Writing</p>
        <h2 id="writing-h">Document control for AI-assisted development</h2>
        <p>
          Twenty years of construction document control, mapped onto building software with AI agents: witnessed tests over
          accepted claims, plan versus as-built, reasoning as the asset, and a corpus that sheds superseded revisions.
        </p>
        <p><a href="/writing/document-control-for-ai-agents/">Read the essay →</a></p>
      </div>
      <blockquote class="pull">
        <p>Put it in alarm. Watch it close.</p>
      </blockquote>
    </div>
  </section>

  <section class="section contact" aria-labelledby="contact-h">
    <div class="wrap contact-in">
      <div>
        <p class="anno">Contact</p>
        <h2 id="contact-h">Start with an email.</h2>
        <p>Say what you want built or what your team is trying to do. A person reads every message.</p>
      </div>
      <a class="btn btn-primary mail" href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding: var(--space-7) 0 var(--space-6);
  }
  .sheet {
    position: relative;
    border: 1.5px solid var(--text);
    padding: 26px;
    background: color-mix(in srgb, var(--surface) 70%, transparent);
  }
  .sheet-in {
    position: relative;
    border: 1px solid var(--rule);
    padding: clamp(28px, 6vw, 72px) clamp(20px, 5vw, 64px) clamp(28px, 5vw, 56px);
    overflow: hidden;
  }
  .zones {
    position: absolute;
    display: flex;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    color: var(--muted);
  }
  .zones.top {
    top: 4px;
    left: 26px;
    right: 26px;
    justify-content: space-around;
  }
  .zones.side {
    top: 26px;
    bottom: 26px;
    left: 7px;
    flex-direction: column;
    justify-content: space-around;
  }
  .hero h1 {
    font-size: clamp(2.7rem, 1.2rem + 6.2vw, 6.4rem);
    font-stretch: 125%;
    font-weight: 820;
    letter-spacing: -0.03em;
    line-height: 0.98;
    margin: var(--space-5) 0 var(--space-5);
    max-width: 11ch;
  }
  .mark {
    position: relative;
    color: var(--primary);
    white-space: nowrap;
  }
  .callout {
    position: absolute;
    right: 0.1em;
    bottom: calc(100% + 0.32em);
    white-space: nowrap;
    font-size: 0.68rem;
    font-stretch: 100%;
    letter-spacing: 0.06em;
    line-height: 1;
    padding-bottom: 6px;
    border-bottom: 1px solid var(--accent);
  }
  .callout::after {
    content: "";
    position: absolute;
    left: 0;
    top: 100%;
    width: 1px;
    height: 0.5em;
    background: var(--accent);
    transform: rotate(-32deg);
    transform-origin: top;
  }
  .lede {
    font-size: clamp(1.08rem, 1rem + 0.35vw, 1.28rem);
    max-width: 52ch;
    margin: 0;
  }
  .ctas {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    margin-top: var(--space-6);
  }
  .big-mark {
    position: absolute;
    right: clamp(16px, 4vw, 56px);
    bottom: clamp(18px, 4vw, 48px);
    opacity: 0.9;
  }
  @media (max-width: 620px) {
    .sheet {
      padding: 14px;
    }
    .sheet-in {
      padding: 26px 16px 24px;
    }
    .zones.side {
      display: none;
    }
    .zones.top {
      left: 14px;
      right: 14px;
      top: -1px;
    }
    .hero h1 {
      font-size: 8.6vw;
      font-stretch: 100%;
      letter-spacing: -0.02em;
    }
  }
  @media (max-width: 900px) {
    .big-mark {
      display: none;
    }
    .callout {
      display: none;
    }
  }
  .reveal {
    animation: rise 0.7s var(--ease) both;
  }
  .r2 {
    animation-delay: 0.08s;
  }
  .r3 {
    animation-delay: 0.18s;
  }
  .r4 {
    animation-delay: 0.28s;
  }
  .r5 {
    animation-delay: 0.38s;
  }
  /* Transform only: if animations never run (background tab, print), content is still visible. */
  @keyframes rise {
    from {
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .reveal {
      animation: none;
    }
  }

  .door-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0;
    border: 1.5px solid var(--text);
  }
  .door {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: clamp(22px, 3vw, 40px);
    color: var(--text);
    text-decoration: none;
    background: var(--surface);
    transition: background var(--dur) var(--ease);
  }
  .door + .door {
    border-left: 1.5px solid var(--text);
  }
  .door:hover {
    background: var(--raised);
    color: var(--text);
  }
  .door h3 {
    font-size: var(--text-2xl);
  }
  .door p {
    margin: 0;
    color: var(--muted);
    flex: 1;
  }
  .go {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--primary);
  }
  .door:hover .go {
    text-decoration: underline;
  }
  @media (max-width: 720px) {
    .door-grid {
      grid-template-columns: 1fr;
    }
    .door + .door {
      border-left: 0;
      border-top: 1.5px solid var(--text);
    }
  }

  .feat-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: clamp(24px, 5vw, 72px);
    align-items: start;
  }
  .featured h2 {
    font-size: var(--text-3xl);
    font-stretch: 120%;
    margin-top: var(--space-2);
  }
  .feat-what {
    font-size: var(--text-lg);
    font-weight: 600;
  }
  @media (max-width: 900px) {
    .feat-grid {
      grid-template-columns: 1fr;
    }
  }

  .seq {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border: 1.5px solid var(--text);
    counter-reset: none;
  }
  .seq li {
    padding: 22px 20px 26px;
    background: var(--surface);
    position: relative;
  }
  .seq li + li {
    border-left: 1px solid var(--rule);
  }
  .seq li + li::before {
    content: "";
    position: absolute;
    left: -7px;
    top: 30px;
    width: 12px;
    height: 12px;
    border-top: 1.5px solid var(--text);
    border-right: 1.5px solid var(--text);
    transform: rotate(45deg);
    background: var(--surface);
  }
  .n {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--accent);
  }
  .seq h3 {
    font-size: var(--text-lg);
    margin: var(--space-3) 0 var(--space-2);
  }
  .seq p {
    margin: 0;
    color: var(--muted);
    font-size: 0.95rem;
  }
  @media (max-width: 900px) {
    .seq {
      grid-template-columns: 1fr 1fr;
    }
    .seq li:nth-child(3) {
      border-left: 0;
    }
    .seq li:nth-child(n + 3) {
      border-top: 1px solid var(--rule);
    }
    .seq li::before {
      display: none;
    }
  }
  @media (max-width: 560px) {
    .seq {
      grid-template-columns: 1fr;
    }
    .seq li + li {
      border-left: 0;
      border-top: 1px solid var(--rule);
    }
  }

  .writing {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: clamp(24px, 5vw, 72px);
    align-items: center;
  }
  .writing h2 {
    font-size: var(--text-2xl);
    margin: var(--space-2) 0 var(--space-4);
  }
  .writing p {
    max-width: 60ch;
  }
  .pull {
    margin: 0;
    padding: var(--space-5) 0 var(--space-5) var(--space-5);
    border-left: 3px solid var(--accent);
  }
  .pull p {
    margin: 0;
    font-family: var(--font-display);
    font-stretch: 125%;
    font-weight: 780;
    font-size: var(--text-2xl);
    line-height: 1.1;
  }
  @media (max-width: 720px) {
    .writing {
      grid-template-columns: 1fr;
    }
  }

  .contact-in {
    display: flex;
    gap: var(--space-6);
    align-items: end;
    justify-content: space-between;
    flex-wrap: wrap;
    border: 1.5px solid var(--text);
    background: var(--surface);
    padding: clamp(22px, 4vw, 44px);
  }
  .contact h2 {
    font-size: var(--text-2xl);
    margin: var(--space-2) 0 var(--space-3);
  }
  .contact p {
    margin: 0;
    color: var(--muted);
  }
  .mail {
    font-family: var(--font-mono);
    font-size: 0.95rem;
  }
</style>
