---
/**
 * Home: HLLMR Ventures, the incubator. Industry-neutral on purpose (owner decision 2026-10-18):
 * ventures in any field start here, each with its own front door and skin once it is ready.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import Wordmark from "../components/Wordmark.astro";
import VentureRegister, { type RegisterRow } from "../components/VentureRegister.astro";
import { PROJECTS, PROJECT_STAGE, VENTURES } from "../lib/projects";
import { WRITING } from "../lib/writing";
import { CONTACT_EMAIL, FOUNDER, LINKS, LOCALITY, OWNER, abs } from "../lib/site";

const site = Astro.site;
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": abs("/#organization", site),
      name: OWNER,
      alternateName: "HLLMR",
      url: abs("/", site),
      logo: abs("/favicon.png", site),
      email: CONTACT_EMAIL,
      founder: { "@type": "Person", name: FOUNDER },
      sameAs: [LINKS.github],
    },
    {
      "@type": "WebSite",
      "@id": abs("/#website", site),
      name: "HLLMR Ventures",
      url: abs("/", site),
      publisher: { "@id": abs("/#organization", site) },
    },
  ],
};

const ventures: RegisterRow[] = VENTURES.map((v) => ({
  ...v,
  links: v.slug === "silo" ? [{ label: "case study", href: "/projects/silo/" }, { label: "source", href: LINKS.siloSource }] : undefined,
}));
const projects: RegisterRow[] = PROJECTS.filter((p) => p.slug !== "silo").map((p) => ({
  slug: p.slug,
  name: p.name,
  field: p.kind,
  line: p.what,
  stage: PROJECT_STAGE[p.slug] ?? "Building",
  href: p.page ?? `/projects/#${p.slug}`,
  links: p.links,
}));
const essay = WRITING[0]!;
---

<BaseLayout
  title="HLLMR Ventures · Projects start here"
  description="HLLMR Ventures LLC is where new ventures begin: software, services, entertainment and whatever comes next. Each starts here, proves itself, and gets its own front door when it is ready."
  sheet="Home"
  jsonLd={jsonLd}
>
  <section class="hero">
    <div class="wrap">
      <p class="meta anno">
        <span>{OWNER}</span><span>{LOCALITY}</span><span>Est. 2026</span>
      </p>
      <h1 class="visually-hidden">HLLMR Ventures: projects start here.</h1>
      <div class="big" aria-hidden="true"><Wordmark size="xl" /></div>
      <div class="under">
        <p class="claim">Projects start here.</p>
        <p class="lede">
          HLLMR Ventures is where new things begin: software, services, entertainment and whatever comes next. Each venture
          starts as a line in the register below, proves itself in the open, and gets its own name and front door when it is
          ready.
        </p>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="ventures-h">
    <div class="wrap">
      <div class="head">
        <h2 id="ventures-h">Ventures</h2>
        <p class="count anno">{VENTURES.length} in the register</p>
      </div>
      <VentureRegister rows={ventures} label="Ventures" />
    </div>
  </section>

  <section class="section" aria-labelledby="path-h">
    <div class="wrap">
      <div class="head">
        <h2 id="path-h">How a venture grows</h2>
      </div>
      <ol class="path">
        <li>
          <span class="n anno">01 · Idea</span>
          <h3>Start here</h3>
          <p>An idea gets a line in the register and a page on this site. Nothing more until it earns it.</p>
        </li>
        <li>
          <span class="n anno">02 · Building</span>
          <h3>Prove it</h3>
          <p>It is built and tested in the open, with its limits written down next to its claims.</p>
        </li>
        <li>
          <span class="n anno">03 · Launched</span>
          <h3>Its own front door</h3>
          <p>A launched venture gets its own name, look and address, like silo.hllmr.com.</p>
        </li>
        <li>
          <span class="n anno">04 · Spun out</span>
          <h3>Its own company</h3>
          <p>When it outgrows the house, it moves to its own domain or company. The register keeps the link.</p>
        </li>
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="projects-h">
    <div class="wrap">
      <div class="head">
        <h2 id="projects-h">Projects and tools</h2>
        <p class="count anno"><a href="/projects/">Full schedule →</a></p>
      </div>
      <VentureRegister rows={projects} label="Projects and tools" size="sm" />
    </div>
  </section>

  <section class="section" aria-labelledby="writing-h">
    <div class="wrap two">
      <div>
        <p class="anno">Writing · {essay.kind}</p>
        <h2 id="writing-h"><a href={essay.path}>{essay.title}</a></h2>
      </div>
      <p class="muted">{essay.description} <a href="/writing/">All writing →</a></p>
    </div>
  </section>

  <section class="section contact" aria-labelledby="contact-h">
    <div class="wrap two">
      <h2 id="contact-h">Have something that should start here?</h2>
      <div>
        <p class="muted">A partnership, a project, a booking or a question. One address reaches a person.</p>
        <p><a class="btn btn-primary" href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a></p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding: var(--space-7) 0 var(--space-7);
    border-bottom: 2px solid var(--text);
    overflow: hidden;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 22px;
    margin: 0 0 var(--space-5);
  }
  @media (min-width: 621px) {
    .meta span + span::before {
      content: "·";
      margin-right: 22px;
      color: var(--accent);
    }
  }
  @media (max-width: 620px) {
    .meta {
      flex-direction: column;
    }
  }
  /* Room under the mark for the plumb line and bob to hang clear of the claim. */
  .big {
    margin-left: -0.04em;
    padding-bottom: clamp(56px, 7vw, 120px);
  }
  .under {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(20px, 5vw, 72px);
    align-items: end;
    margin-top: var(--space-6);
  }
  .claim {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-stretch: 118%;
    font-size: clamp(2rem, 1.1rem + 3.4vw, 3.8rem);
    letter-spacing: -0.025em;
    line-height: 1;
  }
  .lede {
    margin: 0;
    font-size: var(--text-lg);
    color: var(--muted);
    max-width: 48ch;
  }
  @media (max-width: 760px) {
    .under {
      grid-template-columns: 1fr;
    }
  }

  .head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-4);
  }
  .head h2 {
    font-size: var(--text-2xl);
    font-stretch: 118%;
  }
  .count a {
    color: var(--text);
  }

  .path {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 2px solid var(--text);
  }
  .path li {
    padding: var(--space-5) var(--space-5) var(--space-5) 0;
  }
  .path li + li {
    padding-left: var(--space-5);
    border-left: 1px solid var(--rule);
  }
  .path h3 {
    font-size: var(--text-xl);
    margin: var(--space-3) 0 var(--space-2);
  }
  .path p {
    margin: 0;
    color: var(--muted);
    font-size: 0.97rem;
  }
  .n {
    color: var(--accent);
  }
  @media (max-width: 900px) {
    .path {
      grid-template-columns: 1fr 1fr;
    }
    .path li:nth-child(3) {
      padding-left: 0;
      border-left: 0;
    }
    .path li:nth-child(n + 3) {
      border-top: 1px solid var(--rule);
    }
  }
  @media (max-width: 560px) {
    .path {
      grid-template-columns: 1fr;
    }
    .path li + li {
      padding-left: 0;
      border-left: 0;
      border-top: 1px solid var(--rule);
    }
  }

  .two {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: clamp(20px, 5vw, 72px);
    align-items: end;
  }
  .two h2 {
    font-size: var(--text-2xl);
    margin-top: var(--space-2);
  }
  .two h2 a {
    color: var(--text);
    text-decoration-color: var(--rule);
  }
  .muted {
    color: var(--muted);
  }
  .contact h2 {
    font-size: var(--text-3xl);
    font-stretch: 120%;
    line-height: 1;
  }
  @media (max-width: 760px) {
    .two {
      grid-template-columns: 1fr;
    }
  }
</style>
