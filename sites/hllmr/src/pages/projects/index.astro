---
/** Projects index (the 2026-08 URL, kept): the full project schedule. */
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHead from "@hllmr/brand/components/PageHead.astro";
import ProjectSchedule from "../../components/ProjectSchedule.astro";
import VentureRegister from "../../components/VentureRegister.astro";
import { PROJECTS, VENTURES } from "@hllmr/portfolio";
import { here } from "../../lib/site";
---

<BaseLayout
  title="The register · HLLMR Ventures"
  description="The HLLMR Ventures register: the four divisions (TOOLS, UPGRADE, LIVE, GAMING) and every project, each with its stage and a link you can check."
  sheet="Register"
>
  <PageHead
    dwg="Register"
    title="Projects start here."
    lede="Everything HLLMR Ventures owns and runs: its four divisions and every project, each with its stage. Where something is public, the link is here so you can check it rather than take our word."
  />
  <section class="section" aria-labelledby="v-h">
    <div class="wrap">
      <h2 id="v-h" class="sh">Divisions</h2>
      <VentureRegister rows={VENTURES.map((v) => ({ ...v, href: v.href && here(v.href) }))} label="Divisions" />
    </div>
  </section>
  <section class="section" aria-labelledby="p-h">
    <div class="wrap">
      <h2 id="p-h" class="sh">Projects</h2>
      <ProjectSchedule projects={PROJECTS} caption="Schedule of projects, current revision" />
    </div>
  </section>
</BaseLayout>

<style>
  .sh {
    font-size: var(--text-2xl);
    margin-bottom: var(--space-4);
  }
</style>
