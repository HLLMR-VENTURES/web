---
/** HLLMR Build, the AI-assisted development venture: the proposition, two equal doors (build for a
 * business / help a team), the featured work, the method, the writing and the contact route.
 * Heraldry direction: the page leads with Build's arms (Azure, a chevron Argent); azure accents. */
import BaseLayout from "../../layouts/BaseLayout.astro";
import Arms from "../../components/Arms.astro";
import ProjectSchedule from "../../components/ProjectSchedule.astro";
import { ARMS } from "../../lib/arms";
import { PROJECTS } from "../../lib/projects";
import { CONTACT_EMAIL, FOUNDER, LINKS, OWNER, abs } from "../../lib/site";

const site = Astro.site;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "HLLMR Build: AI-assisted development",
  url: abs("/build/", site),
  provider: { "@type": "Organization", "@id": abs("/#organization", site), name: OWNER, founder: { "@type": "Person", name: FOUNDER } },
  areaServed: "US",
  email: CONTACT_EMAIL,
  sameAs: [LINKS.github],
};
const silo = PROJECTS[0]!;
---

<BaseLayout
  title="HLLMR Build · Software, commissioned"
  description="HLLMR Build, a venture of HLLMR Ventures, builds software and automation with AI agents, and proves it works before calling it done. We build for businesses and help teams adopt AI-assisted development with discipline."
  sheet="Build: general"
  skin="build"
  ogImage="/build/og.png"
  ogImageAlt="HLLMR Build. Software, commissioned."
  jsonLd={jsonLd}
>
  <section class="hero">
    <div class="wrap hero-in">
      <div class="copy">
        <p class="anno">HLLMR Build · a venture of HLLMR Ventures</p>
        <h1>Software, <em>commissioned.</em></h1>
        <p class="lede">
          We build software and automation with AI agents, and we prove it works before we call it done. The speed is real.
          So is the habit agents have of reporting work finished when it isn't. We bring the second discipline to the first.
        </p>
        <div class="ctas">
          <a class="btn btn-primary" href="/contact/">Start a conversation</a>
          <a class="btn btn-ghost" href="/build/services/">Services</a>
        </div>
      </div>
      <figure class="coat">
        <Arms coat="build" size={220} />
        <figcaption>{ARMS.build.blazon}<span>The chevron began as a pair of rafters: structure, load paths, a thing assembled and inspected.</span></figcaption>
      </figure>
    </div>
  </section>

  <section class="section doors" aria-labelledby="doors-h">
    <div class="wrap">
      <div class="section-head">
        <p class="anno">Two ways in</p>
        <h2 id="doors-h">What we do</h2>
      </div>
      <div class="door-grid">
        <a class="door" href="/build/services/#build">
          <span class="anno anno-red">Detail A</span>
          <h3>Build it for us</h3>
          <p>
            For a business that needs software, an internal tool or an automation built and kept running. We scope it with
            you, build it with AI agents under review, test it against what you asked for, and hand over something you can
            run and audit.
          </p>
          <span class="go">Building with HLLMR →</span>
        </a>
        <a class="door" href="/build/services/#teams">
          <span class="anno anno-red">Detail B</span>
          <h3>Help our team do it</h3>
          <p>
            For an engineering team already using AI coding agents. We set up the guardrails that keep agent work
            honest: bounded work, explicit permissions, independent review, controls tested before they are trusted, and
            a record a new person can follow.
          </p>
          <span class="go">Working with your team →</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section featured" aria-labelledby="featured-h">
    <div class="wrap feat-grid">
      <div>
        <p class="anno">Featured · {silo.tag}</p>
        <h2 id="featured-h"><Arms coat="silo" size={40} form="banner" decorative class="feat-arms" />{silo.name}</h2>
        <p class="feat-what">{silo.what}</p>
        <p>{silo.summary}</p>
        <div class="ctas">
          <a class="btn btn-primary" href="/projects/silo/">Read the case study</a>
          <a class="btn btn-ghost" href={LINKS.silo}>Visit silo.hllmr.com</a>
        </div>
      </div>
      <dl class="spec">
        <dt>Status</dt><dd>{silo.status}</dd>
        <dt>License</dt><dd>MIT, source on GitHub</dd>
        <dt>Platforms</dt><dd>Windows (code-signed), macOS and Linux preview</dd>
        <dt>Stack</dt><dd>Rust and Tauri desktop app, Svelte UI, Node API, Postgres</dd>
        <dt>Runs on</dt><dd>The HLLMR self-hosted stack, released through the same approvals as everything else</dd>
      </dl>
    </div>
  </section>

  <section class="section" aria-labelledby="work-h">
    <div class="wrap">
      <div class="section-head">
        <p class="anno">Project schedule</p>
        <h2 id="work-h">The work</h2>
        <p>Products, infrastructure, methods and libraries. Most of it is public, so you can check it.</p>
      </div>
      <ProjectSchedule projects={PROJECTS} />
    </div>
  </section>

  <section class="section method" aria-labelledby="method-h">
    <div class="wrap">
      <div class="section-head">
        <p class="anno">Sequence of operations</p>
        <h2 id="method-h">How we work</h2>
        <p>
          The method comes from twenty years of commissioning building systems, where nobody accepts a damper because the
          submittal says it closes.
        </p>
      </div>
      <ol class="seq">
        <li>
          <span class="n">01</span>
          <h3>Intent, written and approved</h3>
          <p>What the system is for, decided by a person and kept in the record, not in anyone's memory or chat history.</p>
        </li>
        <li>
          <span class="n">02</span>
          <h3>Bounded work</h3>
          <p>Agents work one scoped unit at a time, with explicit limits on what they may touch.</p>
        </li>
        <li>
          <span class="n">03</span>
          <h3>Witnessed test</h3>
          <p>Every claim is checked by running it. Rollback is exercised before a release is approved, not after it fails.</p>
        </li>
        <li>
          <span class="n">04</span>
          <h3>A record you keep</h3>
          <p>Decisions, with the alternatives that were rejected, stay with the work, so the next person can judge the next change.</p>
        </li>
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="writing-h">
    <div class="wrap writing">
      <div>
        <p class="anno">Writing</p>
        <h2 id="writing-h">Document control for AI-assisted development</h2>
        <p>
          Twenty years of construction document control, mapped onto building software with AI agents: witnessed tests over
          accepted claims, plan versus as-built, reasoning as the asset, and a corpus that sheds superseded revisions.
        </p>
        <p><a href="/writing/document-control-for-ai-agents/">Read the essay →</a></p>
      </div>
      <blockquote class="pull">
        <p>Put it in alarm. Watch it close.</p>
      </blockquote>
    </div>
  </section>

  <section class="section contact" aria-labelledby="contact-h">
    <div class="wrap contact-in">
      <div>
        <p class="anno">Contact</p>
        <h2 id="contact-h">Start with an email.</h2>
        <p>Say what you want built or what your team is trying to do. A person reads every message.</p>
      </div>
      <a class="btn btn-primary mail" href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding: var(--space-8) 0 var(--space-7);
    border-bottom: 1px solid var(--rule);
  }
  .hero-in {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    gap: clamp(28px, 5vw, 72px);
    align-items: end;
  }
  .hero h1 {
    font-size: clamp(3rem, 1.4rem + 6vw, 6.4rem);
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 0.95;
    margin: var(--space-4) 0 var(--space-5);
  }
  .hero h1 em {
    color: var(--venture);
  }
  .lede {
    font-size: var(--text-lg);
    color: var(--muted);
    max-width: 50ch;
    margin: 0;
  }
  .ctas {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    margin-top: var(--space-6);
  }
  .coat {
    margin: 0;
    justify-self: end;
    display: grid;
    justify-items: center;
    gap: 14px;
    max-width: 260px;
  }
  .coat :global(.arms) {
    width: min(220px, 48vw);
    height: auto;
  }
  .coat figcaption {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.15rem;
    text-align: center;
  }
  .coat figcaption span {
    display: block;
    margin-top: 6px;
    font-family: var(--font-ui);
    font-style: normal;
    font-size: 0.85rem;
    color: var(--muted);
  }
  @media (max-width: 760px) {
    .hero-in {
      grid-template-columns: 1fr;
    }
    .coat {
      justify-self: start;
      justify-items: start;
    }
    .coat figcaption {
      text-align: left;
    }
  }

  .door-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0;
    border: 1px solid var(--border);
    border-top: 2px solid var(--venture);
  }
  .door {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: clamp(22px, 3vw, 40px);
    color: var(--text);
    text-decoration: none;
    background: var(--surface);
    transition: background var(--dur) var(--ease);
  }
  .door + .door {
    border-left: 1px solid var(--rule);
  }
  .door:hover {
    background: var(--raised);
    color: var(--text);
  }
  .door h3 {
    font-family: var(--font-display);
    font-weight: 450;
    font-size: var(--text-2xl);
  }
  .door p {
    margin: 0;
    color: var(--muted);
    flex: 1;
  }
  .go {
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: 0.85rem;
    color: var(--venture);
  }
  .door:hover .go {
    text-decoration: underline;
  }
  @media (max-width: 720px) {
    .door-grid {
      grid-template-columns: 1fr;
    }
    .door + .door {
      border-left: 0;
      border-top: 1px solid var(--rule);
    }
  }

  .feat-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: clamp(24px, 5vw, 72px);
    align-items: start;
  }
  .featured h2 {
    display: flex;
    align-items: center;
    gap: 16px;
    font-size: var(--text-3xl);
    margin-top: var(--space-2);
  }
  .feat-what {
    font-size: var(--text-lg);
    font-weight: 600;
  }
  @media (max-width: 900px) {
    .feat-grid {
      grid-template-columns: 1fr;
    }
  }

  .seq {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 2px solid var(--venture);
    counter-reset: none;
  }
  .seq li {
    padding: 22px 20px 26px;
    background: var(--surface);
    position: relative;
  }
  .seq li + li {
    border-left: 1px solid var(--rule);
  }
  .seq li + li::before {
    content: "";
    position: absolute;
    left: -7px;
    top: 30px;
    width: 12px;
    height: 12px;
    border-top: 1px solid var(--rule);
    border-right: 1px solid var(--rule);
    transform: rotate(45deg);
    background: var(--surface);
  }
  .n {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--venture);
  }
  .seq h3 {
    font-size: var(--text-lg);
    margin: var(--space-3) 0 var(--space-2);
  }
  .seq p {
    margin: 0;
    color: var(--muted);
    font-size: 0.95rem;
  }
  @media (max-width: 900px) {
    .seq {
      grid-template-columns: 1fr 1fr;
    }
    .seq li:nth-child(3) {
      border-left: 0;
    }
    .seq li:nth-child(n + 3) {
      border-top: 1px solid var(--rule);
    }
    .seq li::before {
      display: none;
    }
  }
  @media (max-width: 560px) {
    .seq {
      grid-template-columns: 1fr;
    }
    .seq li + li {
      border-left: 0;
      border-top: 1px solid var(--rule);
    }
  }

  .writing {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: clamp(24px, 5vw, 72px);
    align-items: center;
  }
  .writing h2 {
    font-size: var(--text-2xl);
    margin: var(--space-2) 0 var(--space-4);
  }
  .writing p {
    max-width: 60ch;
  }
  .pull {
    margin: 0;
    padding: var(--space-5) 0 var(--space-5) var(--space-5);
    border-left: 3px solid var(--venture);
  }
  .pull p {
    margin: 0;
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    font-size: var(--text-3xl);
    line-height: 1.05;
  }
  @media (max-width: 720px) {
    .writing {
      grid-template-columns: 1fr;
    }
  }

  .contact-in {
    display: flex;
    gap: var(--space-6);
    align-items: end;
    justify-content: space-between;
    flex-wrap: wrap;
    border: 1px solid var(--border);
    border-top: 2px solid var(--text);
    background: var(--surface);
    padding: clamp(22px, 4vw, 44px);
  }
  .contact h2 {
    font-size: var(--text-3xl);
    margin: var(--space-2) 0 var(--space-3);
  }
  .contact p {
    margin: 0;
    color: var(--muted);
  }
  .mail {
    font-family: var(--font-mono);
    font-size: 0.95rem;
  }
</style>
