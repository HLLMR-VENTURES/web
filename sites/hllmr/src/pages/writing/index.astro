---
/** Writing index (was a 404 on the 2026-08 site). */
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHead from "../../components/PageHead.astro";
import { WRITING } from "../../lib/writing";
---

<BaseLayout
  title="Writing · HLLMR Ventures"
  description="Essays and notes from HLLMR Ventures on building software with AI agents, governance, and the engineering discipline that makes agent work trustworthy."
  sheet="Writing"
>
  <PageHead dwg="DWG W-001 · Writing" title="Writing" lede="Essays and notes on building software with AI agents.">
    <p class="feed"><a href="/feed.xml">RSS feed</a></p>
  </PageHead>
  <section class="section">
    <div class="wrap">
      <ol class="list">
        {
          WRITING.map((w) => (
            <li>
              <p class="anno">
                {w.kind} · <time datetime={w.published}>{w.published}</time> · {w.author}
              </p>
              <h2>
                <a href={w.path}>{w.title}</a>
              </h2>
              <p class="d">{w.description}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
</BaseLayout>

<style>
  .feed {
    margin-top: var(--space-4);
    font-family: var(--font-mono);
    font-size: 0.76rem;
  }
  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1.5px solid var(--text);
  }
  .list li {
    padding: var(--space-6) 0;
    border-bottom: 1px solid var(--rule);
  }
  .list h2 {
    font-size: var(--text-2xl);
    margin: var(--space-2) 0 var(--space-3);
  }
  .list h2 a {
    color: var(--text);
    text-decoration-color: var(--rule);
  }
  .list h2 a:hover {
    text-decoration-color: var(--primary);
  }
  .d {
    margin: 0;
    max-width: 66ch;
    color: var(--muted);
  }
</style>
