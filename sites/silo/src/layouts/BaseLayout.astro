---
/**
 * Shared document shell for every silo.hllmr.com page: head metadata from props, the static
 * header and footer (no runtime injection), a skip link and a single <main> landmark.
 */
import "@hllmr/design/silo.css";
import SkipLink from "@hllmr/design/components/SkipLink.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { OWNER, SITE_NAME, abs } from "../lib/site";

interface Props {
  /** Full <title>. */
  title: string;
  description: string;
  /** Social title; defaults to `title`. */
  ogTitle?: string;
  ogDescription?: string;
  /** Path of the share image, relative to the site root. */
  ogImage?: string;
  ogImageAlt?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  ogType?: "website" | "article" | "profile";
  /** noindex pages get no canonical and are left out of the sitemap. */
  noindex?: boolean;
  /** Schema.org graph, serialized into one application/ld+json block. */
  jsonLd?: Record<string, unknown>;
  /** Emit search-engine verification metas (home page only). */
  verification?: boolean;
}

const {
  title,
  description,
  ogTitle = title,
  ogDescription = description,
  ogImage = "/og.png",
  ogImageAlt = "Silo. More farming. Less fixing. A free, open-source Farming Simulator 25 mod manager.",
  ogImageWidth = 1200,
  ogImageHeight = 630,
  ogType = "website",
  noindex = false,
  jsonLd,
  verification = false,
} = Astro.props;

const canonical = abs(Astro.url.pathname, Astro.site);
const image = abs(ogImage, Astro.site);
const googleVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;
const bingVerification = import.meta.env.PUBLIC_BING_SITE_VERIFICATION;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <script is:inline src="/js/theme.js"></script>
    <meta name="description" content={description} />
    {
      noindex ? (
        <meta name="robots" content="noindex, follow" />
      ) : (
        <>
          <link rel="canonical" href={canonical} />
          <meta
            name="robots"
            content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
          />
        </>
      )
    }
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content={String(ogImageWidth)} />
    <meta property="og:image:height" content={String(ogImageHeight)} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={image} />
    <meta name="author" content={OWNER} />
    <meta name="theme-color" content="#4a7330" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#171a14" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" href="/favicon-32.png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {verification && googleVerification && <meta name="google-site-verification" content={googleVerification} />}
    {verification && bingVerification && <meta name="msvalidate.01" content={bingVerification} />}
    {jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, "\\u003c")} />}
    <slot name="head" />
  </head>
  <body>
    <SkipLink target="main" />
    <SiteHeader />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
