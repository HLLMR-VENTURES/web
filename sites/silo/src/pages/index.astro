---
/**
 * Home page, direction A "Daybreak" with B's three-step crash story (owner's pick, 2026-10-18).
 * Rows, cards, FAQ and JSON-LD render from the content collections; the version and the Windows
 * installer link come from the latest app release at build time (src/lib/release.ts).
 * Screenshots are the pre-P2 masters until the Silo developer's showcase kit lands.
 */
import { Picture } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import { features, faq, screens, screenImage, plainText } from "../lib/content";
import { latestRelease, formatSize } from "../lib/release";
import { LINKS, OWNER, abs } from "../lib/site";

const featureList = await features();
const faqList = await faq();
const screenList = await screens();
const screenById = new Map(screenList.map((s) => [s.data.id, s.data]));
const screen = (id: string) => {
  const s = screenById.get(id);
  if (!s) throw new Error(`screens.yaml has no '${id}' entry`);
  return { ...s, src: screenImage(s.file) };
};
const hero = screen("library");
const rows = featureList.filter((f) => f.data.kind === "row").map((f) => ({ ...f.data, shot: screen(f.data.screen!) }));
const cards = featureList.filter((f) => f.data.kind === "card").map((f) => f.data);

const release = await latestRelease();
const winHref = release?.windowsSetup?.url ?? LINKS.releases;
const versionLine = release
  ? `Version ${release.version}, released ${new Date(release.date + "T00:00:00Z").toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric", timeZone: "UTC" })}`
  : "Latest release on GitHub";

const site = Astro.site;
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      name: "Silo",
      url: abs("/", site),
      applicationCategory: "UtilitiesApplication",
      applicationSubCategory: "Mod Manager",
      operatingSystem: "Windows, macOS, Linux",
      description:
        "Silo is a free, open-source mod manager for Farming Simulator 25. It reads your mods and your game log, names the likely culprit when the game crashes, flags conflicts before launch, pulls ModHub and GitHub into one catalog, and checks an installed mod against the build its source published. Organize shows every move before it touches a file, and Undo organizing puts every mod back in your mods folder.",
      downloadUrl: LINKS.releases,
      releaseNotes: release?.pageUrl ?? LINKS.releases,
      ...(release ? { softwareVersion: release.version } : {}),
      isAccessibleForFree: true,
      offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
      author: { "@type": "Organization", name: OWNER, url: LINKS.orgGithub },
      image: abs("/og.png", site),
      screenshot: abs(`/screenshots/${hero.file}`, site),
      featureList: featureList.map((f) => f.data.ld).filter(Boolean),
    },
    { "@type": "Organization", name: OWNER, url: LINKS.orgGithub, sameAs: [LINKS.source] },
    {
      "@type": "FAQPage",
      mainEntity: faqList.map((q) => ({
        "@type": "Question",
        name: q.data.question,
        acceptedAnswer: { "@type": "Answer", text: q.data.answer.map(plainText).join(" ") },
      })),
    },
  ],
};
---

<BaseLayout
  title="Silo · More farming. Less fixing. | Farming Simulator 25 mod manager"
  description="Silo is a free, open-source mod manager for Farming Simulator 25. It reads your mods and your game log, names the likely culprit when you crash, and flags conflicts before launch."
  ogTitle="Silo · More farming. Less fixing."
  ogDescription="Silo reads your mods and your game log, so you can see what broke, what clashes and what's missing before the evening is gone. Free and open source, no account, no telemetry."
  jsonLd={jsonLd}
  verification
>
  <section class="hero">
    <div class="wrap hero-in">
      <div class="hero-copy">
        <p class="kicker">For Farming Simulator 25 players with a lot of mods</p>
        <h1>More farming.<br /><span class="em">Less fixing.</span></h1>
        <p class="lede">
          Silo reads your mods and your game log, so you can see what broke, what clashes and what's missing before the
          evening is gone.
        </p>
        <div class="cta-row">
          <a class="btn btn-primary btn-lg" href="#download">Download for Windows</a>
          <a class="text-link" href="/download/">macOS, Linux and checksums</a>
        </div>
        <p class="version">{versionLine} · free · open source (MIT)</p>
        <ul class="chips" aria-label="Principles">
          <li>No account</li>
          <li>No ads</li>
          <li>No telemetry</li>
          <li>Never edits inside a mod</li>
        </ul>
      </div>
      <figure class="window hero-shot">
        <div class="bar" aria-hidden="true"><span></span><span></span><span></span></div>
        <Picture
          src={hero.src}
          formats={["avif"]}
          fallbackFormat="webp"
          widths={[640, 1080, 1600]}
          sizes="(min-width: 1180px) 640px, (min-width: 900px) 52vw, 100vw"
          alt={hero.alt}
          loading="eager"
          fetchpriority="high"
        />
      </figure>
    </div>
  </section>

  <section class="problem" aria-labelledby="problem-h">
    <div class="wrap">
      <h2 id="problem-h">Hundreds of mods, one evening.</h2>
      <p class="sub">
        Everything drops into one <code>mods/</code> folder and loads at once. With hundreds installed, finding the one that
        broke your game can eat the whole night.
      </p>
      <ol class="probs">
        <li><h3>Mystery crashes</h3><p>The log scrolls a wall of red and the cause is buried somewhere in it.</p></li>
        <li><h3>Silent conflicts</h3><p>Two mods claim the same filltype, vehicle type or script, and one quietly wins.</p></li>
        <li><h3>Version roulette</h3><p>ModHub shows one version, GitHub another. Which one do you have?</p></li>
        <li>
          <h3>Scattered sources</h3><p>A mod lives on ModHub, its developer on GitHub. No one place tells the whole story.</p>
        </li>
      </ol>
    </div>
  </section>

  <section class="story" aria-labelledby="story-h">
    <div class="wrap">
      <h2 id="story-h">From crash to culprit</h2>
      <ol class="steps">
        <li>
          <p class="n">1 · The game crashes</p>
          <p>Come back to Silo. It has already read <code>log.txt</code>, and the crash notice names the mod most likely behind it.</p>
        </li>
        <li>
          <p class="n">2 · Park it</p>
          <p>One click sets that mod aside and leaves the rest of your set as it was. The switch can be undone.</p>
        </li>
        <li>
          <p class="n">3 · Log says nothing?</p>
          <p>
            <strong>Find the problem mod</strong> switches half your mods off, you relaunch, and it narrows down from there.
            Then it puts your set back.
          </p>
        </li>
      </ol>
    </div>
  </section>

  <section class="rows" aria-label="What Silo does">
    <div class="wrap">
      {
        rows.map((r, i) => (
          <article class:list={["row", { flip: i % 2 === 1 }]} id={r.id}>
            <div class="row-copy">
              <p class="kicker">{r.kicker}</p>
              <h2>{r.title}</h2>
              <p set:html={r.body} />
              {r.help && (
                <p>
                  <a class="text-link" href={r.help.href}>
                    {r.help.label}
                  </a>
                </p>
              )}
            </div>
            <figure class="window row-shot">
              <div class="bar" aria-hidden="true">
                <span />
                <span />
                <span />
              </div>
              <Picture
                src={r.shot.src}
                formats={["avif"]}
                fallbackFormat="webp"
                widths={[640, 1080, 1600]}
                sizes="(min-width: 1180px) 620px, (min-width: 900px) 52vw, 100vw"
                alt={r.shot.alt}
                loading="lazy"
              />
            </figure>
          </article>
        ))
      }
    </div>
  </section>

  <section class="rest" aria-labelledby="rest-h">
    <div class="wrap">
      <h2 id="rest-h">And the rest of the job</h2>
      <ul class="cards">
        {
          cards.map((c) => (
            <li class="card">
              <h3>{c.title}</h3>
              <p set:html={c.body} />
              {c.help && <a href={c.help.href}>{c.help.label}</a>}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="band" aria-labelledby="trust-h">
    <div class="wrap">
      <h2 id="trust-h">Your machine, your files, your accounts.</h2>
      <div class="pillars">
        <div>
          <h3>Open source</h3>
          <p>
            The app's source is on GitHub under the MIT license. Audit it, fork it, build it yourself. The catalog it talks to
            is a separate hosted service.
          </p>
        </div>
        <div>
          <h3>Quiet</h3>
          <p>
            No account, no ads, no telemetry. Silo contacts its catalog only when you search, open a mod's details, check
            for updates or verify a mod. The <a href="/legal/privacy-policy.html">privacy policy</a> lists every connection.
          </p>
        </div>
        <div>
          <h3>Careful with your files</h3>
          <p>
            Silo never edits inside a mod, and Organize shows every move first. Updates keep the previous version, and
            settings and saves are backed up before Silo edits them.
          </p>
        </div>
        <div>
          <h3>Windows first</h3>
          <p>One native app with no runtime to install. macOS and Linux builds exist and testers are welcome.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="faq-sec" aria-labelledby="faq-h">
    <div class="wrap">
      <h2 id="faq-h">Straight answers</h2>
      <div class="faq">
        {
          faqList.map((q) => (
            <details>
              <summary>{q.data.question}</summary>
              {[...q.data.answer, ...q.data.visibleOnly].map((p) => (
                <p set:html={p} />
              ))}
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section class="dl" id="download" aria-labelledby="dl-h">
    <div class="wrap dl-in">
      <div class="dl-copy">
        <h2 id="dl-h">Get Silo</h2>
        <p>Free and open source. {versionLine}.</p>
        <div class="cta-row">
          <a class="btn btn-primary btn-lg" href={winHref}>Download for Windows</a>
          {release?.windowsSetup && <span class="size">{formatSize(release.windowsSetup.size)} · setup .exe</span>}
        </div>
        <p class="small">
          Recommended: the setup <code>.exe</code> installs for your user account without administrator rights.
          {
            release?.windowsMsi ? (
              <>
                The <a href={release.windowsMsi.url}>.msi</a> installs for all users and needs administrator rights.
              </>
            ) : (
              <>The .msi on the <a href={LINKS.releases}>Releases page</a> installs for all users.</>
            )
          }
        </p>
      </div>
      <div class="dl-notes">
        <h3>Signed for Windows</h3>
        <p>
          Windows installers are <a href={LINKS.verifyDownload}>digitally signed</a> by David Hellmer, Silo's developer.
          SmartScreen may still prompt on a brand-new release, but it shows the publisher instead of "unknown". After that,
          Silo updates itself: it checks for a new version of the app at launch and installs it in one click.
        </p>
        <h3 id="other-platforms">macOS and Linux</h3>
        <p>
          Builds for macOS (Intel and Apple Silicon) and Linux (AppImage, .deb, .rpm) are on the <a
            href={release?.pageUrl ?? LINKS.releases}>Releases page</a
          >. They are unsigned and largely untested, so testers are welcome. On a Mac, open Silo once, then choose <strong
            >Open Anyway</strong
          > in System Settings, Privacy &amp; Security.
        </p>
        <p>
          <a href="/download/">Every installer with its checksum</a> · <a href={LINKS.source}>Read and build the source</a>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  section {
    padding: 80px 0;
  }
  h2 {
    font-size: var(--text-2xl);
    line-height: var(--leading-tight);
  }
  .kicker {
    margin: 0 0 14px;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--earth-text);
  }
  .text-link {
    color: var(--primary-text);
    font-weight: 600;
  }
  .btn-lg {
    font-size: 1.05rem;
    padding: 14px 24px;
    min-height: 48px;
  }
  .window {
    margin: 0;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--frame);
    box-shadow:
      0 0 0 1px var(--border),
      var(--shadow-2);
  }
  .window .bar {
    display: flex;
    gap: 7px;
    padding: 11px 14px;
  }
  .window .bar span {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--frame-dot);
  }
  .window :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  /* Hero */
  .hero {
    padding: 72px 0 64px;
  }
  .hero-in {
    display: flex;
    flex-wrap: wrap;
    gap: 48px;
    align-items: center;
  }
  .hero-copy {
    flex: 1 1 480px;
    min-width: 0;
  }
  .hero-shot {
    flex: 1 1 480px;
    min-width: 0;
  }
  .hero h1 {
    font-size: clamp(2.9rem, 1.6rem + 4vw, 4.9rem);
    line-height: 1;
    letter-spacing: -0.012em;
    font-variation-settings: "SOFT" 50;
  }
  .hero h1 .em {
    color: var(--primary-text);
  }
  .lede {
    font-size: 1.2rem;
    color: var(--muted);
    margin: 24px 0 0;
    max-width: 34em;
  }
  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 20px;
    align-items: center;
    margin-top: 32px;
  }
  .version {
    margin: 16px 0 0;
    font-size: 0.9rem;
    color: var(--muted);
  }
  .chips {
    list-style: none;
    padding: 0;
    margin: 24px 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .chips li {
    border: 1px solid var(--border);
    background: var(--surface);
    border-radius: 999px;
    padding: 4px 14px;
    font-size: 0.88rem;
  }

  /* Problem band */
  .problem {
    background: var(--sunken);
    border-block: 1px solid var(--border);
    padding: 64px 0;
  }
  .sub {
    color: var(--muted);
    max-width: 44em;
    margin: 12px 0 0;
  }
  .probs {
    list-style: none;
    padding: 0;
    margin: 36px 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 28px;
    counter-reset: prob;
  }
  .probs li {
    counter-increment: prob;
  }
  .probs li::before {
    content: "0" counter(prob);
    display: block;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--earth-text);
  }
  .probs h3 {
    font-family: var(--font-ui);
    font-size: 1.15rem;
    font-weight: 700;
    margin: 4px 0 6px;
  }
  .probs p {
    margin: 0;
    color: var(--muted);
  }

  /* Crash story */
  .story {
    padding: 72px 0 24px;
  }
  .steps {
    list-style: none;
    padding: 0;
    margin: 32px 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 24px 32px;
  }
  .steps li {
    border-top: 3px solid var(--primary);
    padding-top: 18px;
  }
  .steps li:first-child {
    border-top-color: var(--accent);
  }
  .steps .n {
    margin: 0;
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--primary-text);
  }
  .steps p:not(.n) {
    margin: 8px 0 0;
    color: var(--muted);
  }

  /* Feature rows */
  .rows {
    padding: 56px 0 24px;
  }
  .rows .wrap {
    display: flex;
    flex-direction: column;
    gap: 88px;
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    gap: 40px 56px;
    align-items: center;
  }
  .row.flip {
    flex-direction: row-reverse;
  }
  .row-copy {
    flex: 1 1 340px;
    min-width: 0;
  }
  .row-copy h2 {
    font-size: clamp(1.9rem, 1.4rem + 1.6vw, 2.6rem);
    margin-bottom: 14px;
  }
  .row-copy p {
    color: var(--muted);
    margin: 0 0 12px;
  }
  .row-copy p :global(strong) {
    color: var(--text);
  }
  .row-shot {
    flex: 1 1 520px;
    min-width: 0;
  }

  /* Cards */
  .cards {
    list-style: none;
    padding: 0;
    margin: 28px 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 16px;
  }
  .card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 22px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .card h3 {
    font-size: 1.2rem;
  }
  .card p {
    margin: 0;
    color: var(--muted);
    flex: 1;
  }
  .card a {
    color: var(--primary-text);
    font-weight: 600;
    padding: 4px 0;
  }

  /* Trust band */
  .band {
    background: var(--band);
    color: var(--on-band);
  }
  .band h2 {
    max-width: 18em;
  }
  .pillars {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 28px;
    margin-top: 32px;
  }
  .pillars h3 {
    font-size: 1.25rem;
    margin-bottom: 8px;
  }
  .pillars p {
    margin: 0;
    color: var(--on-band-muted);
  }
  .band a {
    color: var(--on-band);
  }
  .band :focus-visible {
    outline-color: var(--gold-300);
  }

  /* FAQ */
  .faq {
    display: grid;
    gap: 12px;
    max-width: 780px;
    margin-top: 28px;
  }
  .faq details {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 2px 20px;
  }
  .faq summary {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.1rem;
    cursor: pointer;
    padding: 14px 0;
  }
  .faq p {
    color: var(--muted);
    margin: 0 0 16px;
  }
  .faq p :global(a) {
    color: var(--primary-text);
  }

  /* Download */
  .dl {
    background: var(--surface);
    border-top: 1px solid var(--border);
  }
  .dl-in {
    display: flex;
    flex-wrap: wrap;
    gap: 40px 64px;
  }
  .dl-copy {
    flex: 1 1 360px;
  }
  .dl-copy > p {
    color: var(--muted);
    margin: 12px 0 0;
  }
  .dl-copy .cta-row {
    margin-top: 24px;
  }
  .size {
    color: var(--muted);
    font-size: 0.9rem;
  }
  .small {
    font-size: 0.92rem;
    margin-top: 18px !important;
  }
  .dl-notes {
    flex: 1 1 400px;
    color: var(--muted);
  }
  .dl-notes h3 {
    color: var(--text);
    font-size: 1.15rem;
    margin: 0 0 6px;
  }
  .dl-notes p {
    margin: 0 0 20px;
  }
  .dl a {
    color: var(--primary-text);
  }
  .dl .btn-primary {
    color: var(--on-primary);
  }
</style>
