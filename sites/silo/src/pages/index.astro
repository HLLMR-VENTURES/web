---
/**
 * Home page, ported at parity from Silo/landing/index.html (2026-10-17): same sections, copy and
 * links. Changes are structural only: static chrome, a <main> landmark, data-driven cards/FAQ/
 * JSON-LD, AVIF/WebP screenshots with dimensions, a native <dialog> lightbox (no inline handlers)
 * and a focus ring that passes 3:1.
 */
import { Picture, getImage } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import { features, faq, screens, screenImage, plainText } from "../lib/content";
import { LINKS, OWNER, abs } from "../lib/site";

const featureList = await features();
const faqList = await faq();
const screenList = await screens();
const hero = screenList.find((s) => s.data.id === "library");
if (!hero) throw new Error("screens.yaml needs a 'library' entry for the hero");
const gallery = await Promise.all(
  screenList
    .filter((s) => s.data.gallery)
    .map(async (s) => {
      const src = screenImage(s.data.file);
      const full = await getImage({ src, format: "webp", width: src.width });
      return { ...s.data, src, full: full.src };
    }),
);

const site = Astro.site;
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      name: "Silo",
      url: abs("/", site),
      applicationCategory: "UtilitiesApplication",
      applicationSubCategory: "Mod Manager",
      operatingSystem: "Windows, macOS, Linux",
      description:
        "Silo is a free, open-source mod manager for Farming Simulator 25. It reads your mods and your game log, ranks the likely culprit when the game crashes, flags conflicts before launch, pulls ModHub and GitHub into one catalog, and checks an installed mod against the build its source published. Organize shows every move before it touches a file, and Restore vanilla layout puts every mod back in your mods folder.",
      downloadUrl: LINKS.releases,
      releaseNotes: LINKS.releases,
      isAccessibleForFree: true,
      offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
      author: { "@type": "Organization", name: OWNER, url: LINKS.orgGithub },
      image: abs("/og.png", site),
      screenshot: abs(`/screenshots/${hero.data.file}`, site),
      featureList: featureList.map((f) => f.data.ld).filter(Boolean),
    },
    { "@type": "Organization", name: OWNER, url: LINKS.orgGithub, sameAs: [LINKS.source] },
    {
      "@type": "FAQPage",
      mainEntity: faqList.map((q) => ({
        "@type": "Question",
        name: q.data.question,
        acceptedAnswer: { "@type": "Answer", text: q.data.answer.map(plainText).join(" ") },
      })),
    },
  ],
};
---

<BaseLayout
  title="Silo — More farming. Less fixing. | Farming Simulator 25 mod manager"
  description="Silo is a free, open-source mod manager for Farming Simulator 25. It reads your mods and your game log, points to the likely culprit when you crash, and flags conflicts before launch."
  ogTitle="Silo — More farming. Less fixing."
  ogDescription="Silo reads your mods and your game log, so you can see what broke, what clashes and what's missing before the evening is gone. Free and open source, no account, no telemetry."
  jsonLd={jsonLd}
  verification
>
  <section class="hero">
    <div class="hero-glow"></div>
    <canvas class="furrows" aria-hidden="true"></canvas>
    <div class="wrap hero-in">
      <div class="hero-copy">
        <p class="eyebrow reveal">For Farming Simulator 25 players with a lot of mods</p>
        <h1 class="reveal d1">More <em>farming.</em> Less fixing.</h1>
        <p class="lede reveal d2">
          Silo reads your mods and your game log, so you can see what broke, what clashes and what's missing before the
          evening is gone.
        </p>
        <div class="cta-row reveal d2">
          <a class="btn btn-primary" href="#download">Download for Windows</a>
          <a class="btn btn-ghost" href="#download">macOS and Linux preview</a>
        </div>
        <ul class="trust-line reveal d3" aria-label="Principles">
          <li><span class="dot"></span> No account</li>
          <li><span class="dot"></span> No ads</li>
          <li><span class="dot"></span> No telemetry</li>
          <li><span class="dot"></span> Open source (MIT)</li>
        </ul>
      </div>

      <figure class="hero-shot reveal d3">
        <Picture
          src={screenImage(hero.data.file)}
          formats={["avif"]}
          fallbackFormat="webp"
          widths={[640, 1080, 1416]}
          sizes="(min-width: 1128px) 1080px, 100vw"
          alt={hero.data.alt}
          loading="eager"
          fetchpriority="high"
        />
      </figure>
    </div>
  </section>

  <section class="problem" id="problem">
    <div class="wrap">
      <div class="sec-head">
        <p class="eyebrow">The problem</p>
        <h2>Hundreds of mods, one evening.</h2>
        <p>
          Everything drops into one <code>mods/</code> folder and loads at once. With hundreds of mods installed, finding
          the one that broke your game can eat the whole night. Silo helps with that part.
        </p>
      </div>
      <div class="prob-grid">
        <div class="prob">
          <span class="mk">01</span><div
            ><b>Mystery crashes.</b><p>
              The log scrolls a wall of red and the cause is buried somewhere in it. You disable mods at random and hope.
            </p></div
          >
        </div>
        <div class="prob">
          <span class="mk">02</span><div
            ><b>Silent conflicts.</b><p>
              Two mods claim the same map, filltype or vehicle type, and one of them quietly wins.
            </p></div
          >
        </div>
        <div class="prob">
          <span class="mk">03</span><div
            ><b>Version roulette.</b><p>
              The same mod can show one version on ModHub and a newer one on GitHub, and it's hard to tell which one you
              have.
            </p></div
          >
        </div>
        <div class="prob">
          <span class="mk">04</span><div
            ><b>Scattered sources.</b><p>A mod lives on ModHub, its dev on GitHub. No one place tells the whole story.</p></div
          >
        </div>
      </div>
    </div>
  </section>

  <section id="features">
    <div class="wrap">
      <div class="sec-head">
        <p class="eyebrow">What Silo does</p>
        <h2>A management layer, not another downloader.</h2>
        <p>
          Reading archives, decoding icons, hashing files: the slow work runs in Rust, off the UI thread. The app stays
          quick even with 700+ mods installed.
        </p>
      </div>
      <div class="feat-grid">
        {
          featureList
            .filter((f) => f.data.card)
            .map((f) =>
              f.data.wide ? (
                <div class="card wide">
                  <div class="glyph" aria-hidden="true">{f.data.glyph}</div>
                  <div>
                    <h3>{f.data.title}</h3>
                    <p set:html={f.data.body} />
                  </div>
                  <a class="btn btn-ghost" href="#download">Try it</a>
                </div>
              ) : (
                <div class="card">
                  <div class="glyph" aria-hidden="true">{f.data.glyph}</div>
                  <h3>{f.data.title}</h3>
                  <p set:html={f.data.body} />
                </div>
              ),
            )
        }
      </div>
    </div>
  </section>

  <section id="screens">
    <div class="wrap">
      <div class="sec-head">
        <p class="eyebrow">See it</p>
        <h2>One app for the whole job.</h2>
        <p>Real screens — click any to enlarge.</p>
      </div>
      <div class="screens">
        {
          gallery.map((s) => (
            <figure class="shot">
              <button
                type="button"
                data-shot={s.full}
                data-caption={s.dialogCaption ?? s.caption}
                aria-label={`Enlarge: ${s.dialogCaption ?? s.caption}`}
              >
                <Picture
                  src={s.src}
                  formats={["avif"]}
                  fallbackFormat="webp"
                  widths={[480, 720, 1080]}
                  sizes="(min-width: 900px) 360px, (min-width: 620px) 50vw, 100vw"
                  alt={s.alt}
                  loading="lazy"
                />
              </button>
              <figcaption>{s.caption}</figcaption>
            </figure>
          ))
        }
      </div>
      <dialog id="lightbox" class="lb" aria-label="Screenshot">
        <button class="lb-x" type="button" aria-label="Close" data-close>✕</button>
        <figure><figcaption id="lb-cap"></figcaption></figure>
      </dialog>
    </div>
  </section>

  <section id="ethos">
    <div class="wrap">
      <div class="ethos">
        <p class="eyebrow">Why you can trust it</p>
        <h2>Your machine, your files, your accounts.</h2>
        <div class="ethos-grid">
          <div>
            <p class="m">// open</p>
            <h3>Open source</h3>
            <p>
              The desktop app's source is on GitHub under the MIT license. Audit it, fork it, build it yourself. The catalog
              it talks to is a separate hosted service.
            </p>
          </div>
          <div>
            <p class="m">// quiet</p>
            <h3>No account, no ads, no telemetry</h3>
            <p>
              Silo contacts its catalog only when you search Browse, open a mod's details, check for updates or verify a
              mod. It also checks GitHub for its own app updates at launch, which sends no library data. Your saves, mod
              files and notes stay on your machine. The <a href="/legal/privacy-policy.html">privacy policy</a> lists every
              connection.
            </p>
          </div>
          <div>
            <p class="m">// safe</p>
            <h3>Undoable</h3>
            <p>
              Silo files your mods into a local archive and links the active set into the game. Organize shows you every
              move before it touches a file. Restore vanilla layout puts every mod back in your mods folder. Updates keep
              the previous version in <code>backups/</code>, and Silo backs up settings and savegames before editing them.
              It only ever removes files it put there itself.
            </p>
          </div>
          <div>
            <p class="m">// everywhere</p>
            <h3>Windows today · macOS and Linux preview</h3>
            <p>
              One native app, per-OS game discovery, no runtime. Windows is tested; macOS and Linux are a preview and
              seeking testers.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="how">
    <div class="wrap">
      <div class="sec-head">
        <p class="eyebrow">How it works</p>
        <h2>Point it at your mods. Play.</h2>
      </div>
      <ol class="steps">
        <li class="step">
          <div class="n">Scan</div>
          <h3>It reads your library</h3>
          <p>
            Silo finds your mods folder and reads each mod's <code>modDesc.xml</code> in the background without extracting
            the zip, sorting each one by type. The result is cached, so later scans are quick.
          </p>
        </li>
        <li class="step">
          <div class="n">Curate</div>
          <h3>Organize &amp; check</h3>
          <p>
            Sort, tag and rate your mods, then build loadouts. Conflicts and update status show up here, before you ever
            launch the game.
          </p>
        </li>
        <li class="step">
          <div class="n">Launch</div>
          <h3>Switch &amp; play</h3>
          <p>
            Switching a mod on or off, or applying a loadout, changes the links in the game's mods folder right away. Launch
            just starts the game. Switch loadouts between sessions as often as you like; your archived zips stay put.
          </p>
        </li>
      </ol>
    </div>
  </section>

  <hr class="rule" />

  <section id="faq">
    <div class="wrap">
      <div class="sec-head">
        <p class="eyebrow">Questions</p>
        <h2>Straight answers.</h2>
      </div>
      <div class="faq">
        {
          faqList.map((q) => (
            <details>
              <summary>{q.data.question}</summary>
              {[...q.data.answer, ...q.data.visibleOnly].map((p) => (
                <p set:html={p} />
              ))}
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section class="dl" id="download">
    <div class="wrap">
      <div class="sec-head">
        <p class="eyebrow">Download</p>
        <h2>Get the beta.</h2>
        <p>Free and open source. Grab the installer for your platform, or build it from source.</p>
      </div>
      <div class="dl-row">
        <a class="dl-btn" href={LINKS.releases}
          ><span class="os" aria-hidden="true">⊞</span><span class="l"><b>Windows</b><span>.msi / .exe</span></span></a
        >
        <a class="dl-btn" href={LINKS.releases}
          ><span class="os" aria-hidden="true"></span><span class="l"
            ><b>macOS</b><span>.dmg · preview</span></span
          ></a
        >
        <a class="dl-btn" href={LINKS.releases}
          ><span class="os" aria-hidden="true">🐧</span><span class="l"
            ><b>Linux</b><span>.AppImage / .deb / .rpm · preview</span></span
          ></a
        >
      </div>
      <p class="dl-note">
        <strong
          >Windows is the tested platform; macOS and Linux are a preview and largely untested, so testers are welcome.</strong
        > Windows installers are <a href={LINKS.verifyDownload}>digitally signed</a> by David Hellmer, Silo's developer. SmartScreen
        may still prompt on a brand-new release while reputation builds, but it shows the publisher instead of "unknown". We
        recommend the setup <code>.exe</code>: it installs for your user account without administrator rights. The <code
          >.msi</code
        > installs for all users and needs administrator rights. macOS and Linux builds are open source and unsigned. On a Mac,
        open Silo once, then click <strong>Open Anyway</strong> in System Settings → Privacy &amp; Security. You can <a
          href={LINKS.source}>read or build the source</a
        > to verify. After that, Silo updates itself: it checks on launch and installs the next version in one click.
      </p>
    </div>
  </section>
</BaseLayout>

<script>
  // Ambient golden-hour field furrows: perspective lines converging to a horizon.
  const c = document.querySelector<HTMLCanvasElement>(".furrows");
  if (c) {
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) {
      c.remove();
    } else {
      const ctx = c.getContext("2d");
      const resize = () => {
        const r = c.getBoundingClientRect();
        c.width = r.width * devicePixelRatio;
        c.height = r.height * devicePixelRatio;
        ctx?.setTransform(devicePixelRatio, 0, 0, devicePixelRatio, 0, 0);
      };
      const draw = () => {
        if (!ctx) return;
        const w = c.clientWidth;
        const h = c.clientHeight;
        ctx.clearRect(0, 0, w, h);
        const vpx = w * 0.78;
        const vpy = -30; // vanishing point up-right, matching the glow
        const soil = getComputedStyle(document.documentElement).getPropertyValue("--soil-500").trim();
        ctx.strokeStyle = soil || "#8a6a45";
        ctx.globalAlpha = 0.22;
        ctx.lineWidth = 1;
        for (let i = -8; i <= 24; i++) {
          const x = (i / 16) * w;
          ctx.beginPath();
          ctx.moveTo(x, h + 4);
          ctx.lineTo(vpx, vpy);
          ctx.stroke();
        }
        ctx.globalAlpha = 1;
      };
      resize();
      draw();
      addEventListener("resize", () => {
        resize();
        draw();
      });
      matchMedia("(prefers-color-scheme: dark)").addEventListener("change", draw);
    }
  }

  // Screenshot lightbox on a native <dialog>: focus moves in, Esc closes, focus returns.
  const lb = document.querySelector<HTMLDialogElement>("#lightbox");
  const cap = document.querySelector<HTMLElement>("#lb-cap");
  if (lb && cap) {
    // The <img> is created here so the static markup never carries an <img> without a src.
    const img = document.createElement("img");
    cap.before(img);
    for (const btn of document.querySelectorAll<HTMLButtonElement>("[data-shot]")) {
      btn.addEventListener("click", () => {
        img.src = btn.dataset.shot ?? "";
        img.alt = btn.dataset.caption ?? "";
        cap.textContent = btn.dataset.caption ?? "";
        lb.showModal();
      });
    }
    lb.querySelector("[data-close]")?.addEventListener("click", () => lb.close());
    lb.addEventListener("click", (e) => {
      if (e.target === lb) lb.close();
    });
    lb.addEventListener("close", () => {
      img.removeAttribute("src");
    });
  }
</script>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding: 84px 0 48px;
  }
  .hero-glow {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background:
      radial-gradient(120% 80% at 78% -8%, color-mix(in srgb, var(--gold-500) 30%, transparent), transparent 55%),
      radial-gradient(90% 70% at 12% 8%, color-mix(in srgb, var(--green-500) 16%, transparent), transparent 60%);
  }
  .furrows {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    width: 100%;
    height: 240px;
    z-index: 0;
    opacity: 0.5;
    pointer-events: none;
  }
  .hero-in {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .hero-copy {
    max-width: 62ch;
  }
  .hero h1 {
    font-size: clamp(2.5rem, 4.6vw, 3.9rem);
    line-height: 1.04;
    letter-spacing: -0.015em;
  }
  .hero h1 em {
    font-style: italic;
    color: var(--primary);
  }
  .lede {
    color: var(--muted);
    font-size: 1.12rem;
    margin: 22px auto 26px;
    max-width: 58ch;
  }
  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
    justify-content: center;
  }
  .trust-line {
    list-style: none;
    padding: 0;
    margin: 22px 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 18px;
    justify-content: center;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted);
  }
  .trust-line li {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .trust-line .dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--green-500);
  }
  .hero-shot {
    margin: 50px 0 0;
    width: 100%;
    max-width: 1080px;
  }
  .hero-shot :global(img) {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 16px;
    border: 1px solid var(--border);
    box-shadow: var(--shadow-2);
    background: var(--surface);
  }

  .reveal {
    opacity: 0;
    transform: translateY(14px);
    animation: rise 0.7s var(--ease) forwards;
  }
  .reveal.d1 {
    animation-delay: 0.06s;
  }
  .reveal.d2 {
    animation-delay: 0.14s;
  }
  .reveal.d3 {
    animation-delay: 0.22s;
  }
  @keyframes rise {
    to {
      opacity: 1;
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .reveal {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }

  section {
    padding: 68px 0;
  }
  .sec-head {
    max-width: 40ch;
    margin-bottom: 38px;
  }
  .sec-head h2 {
    font-size: var(--text-2xl);
    line-height: var(--leading-tight);
  }
  .sec-head p {
    color: var(--muted);
    margin: 12px 0 0;
  }
  .rule {
    border: none;
    border-top: 1px solid var(--border);
    margin: 0;
  }

  .problem {
    background: var(--surface);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }
  .prob-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 30px 48px;
  }
  .prob {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 14px;
    align-items: start;
  }
  .prob .mk {
    font-family: var(--font-mono);
    color: var(--barn-500);
    font-size: 0.8rem;
    padding-top: 3px;
  }
  .prob b {
    font-family: var(--font-display);
    font-weight: 600;
  }
  .prob p {
    margin: 4px 0 0;
    color: var(--muted);
    font-size: 0.98rem;
  }

  .feat-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }
  .card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 22px;
    transition:
      transform var(--dur-fast),
      box-shadow var(--dur-fast),
      border-color var(--dur-fast);
  }
  .card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-1);
    border-color: color-mix(in srgb, var(--primary) 30%, var(--border));
  }
  .card .glyph {
    width: 40px;
    height: 40px;
    border-radius: 10px;
    display: grid;
    place-items: center;
    font-size: 20px;
    margin-bottom: 14px;
    background: color-mix(in srgb, var(--primary) 12%, transparent);
    color: var(--primary);
  }
  .card h3 {
    font-size: 1.16rem;
  }
  .card p {
    color: var(--muted);
    font-size: 0.96rem;
    margin: 8px 0 0;
  }
  .card.wide {
    grid-column: span 3;
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 22px;
    align-items: center;
    padding: 20px 24px;
  }
  .card.wide .glyph {
    margin: 0;
  }
  .card.wide p {
    margin: 6px 0 0;
  }

  .screens {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  .shot {
    margin: 0;
  }
  .shot button {
    display: block;
    width: 100%;
    padding: 0;
    border: none;
    background: none;
    cursor: zoom-in;
    border-radius: var(--radius);
  }
  .shot :global(img) {
    width: 100%;
    height: auto;
    display: block;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-1);
    background: var(--surface);
    transition:
      transform var(--dur-fast),
      box-shadow var(--dur-fast),
      border-color var(--dur-fast);
  }
  .shot button:hover :global(img),
  .shot button:focus-visible :global(img) {
    transform: translateY(-3px);
    box-shadow: var(--shadow-2);
    border-color: color-mix(in srgb, var(--primary) 35%, var(--border));
  }
  .shot figcaption {
    margin-top: 10px;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .lb {
    border: none;
    padding: 4vh 4vw;
    background: transparent;
    max-width: none;
    max-height: none;
    width: 100vw;
    height: 100vh;
    margin: 0;
  }
  .lb[open] {
    display: grid;
    place-items: center;
  }
  .lb::backdrop {
    background: rgba(8, 12, 8, 0.86);
  }
  .lb figure {
    margin: 0;
    max-width: 1200px;
    width: 100%;
  }
  .lb :global(img) {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 12px;
    border: 1px solid var(--border);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.5);
  }
  .lb figcaption {
    margin-top: 12px;
    text-align: center;
    color: #dfe6d6;
    font-size: 0.95rem;
  }
  .lb-x {
    position: fixed;
    top: 18px;
    right: 22px;
    width: 40px;
