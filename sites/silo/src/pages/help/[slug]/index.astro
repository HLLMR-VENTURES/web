---
/**
 * One help topic per Markdown file in src/content/help/, at /help/<id>/. The h1 carries the old
 * single-page anchor id (for example id="crash-triage-h") so links that reach this page with the
 * old fragment still land on the right heading. A topic with launch videos (src/lib/videos.ts)
 * ends with them under "Watch it", linked from just below the title.
 */
import { render } from "astro:content";
import HelpLayout from "../../../layouts/HelpLayout.astro";
import ShotViewer from "../../../components/ShotViewer.astro";
import VideoFacade from "../../../components/VideoFacade.astro";
import { topics } from "../../../lib/help";
import { VIDEOS } from "../../../lib/videos";

export async function getStaticPaths() {
  const all = await topics();
  for (const v of VIDEOS) {
    if (v.help && !all.some((t) => t.id === v.help)) throw new Error(`video ${v.id}: no help topic "${v.help}"`);
  }
  return all.map((t, i) => ({ params: { slug: t.id }, props: { topic: t, prev: all[i - 1], next: all[i + 1] } }));
}

const { topic, prev, next } = Astro.props;
const { Content } = await render(topic);
const videos = VIDEOS.filter((v) => v.help === topic.id);
---

<HelpLayout title={`${topic.data.title} · Silo help`} description={topic.data.summary} current={topic.id}>
  <article class="prose">
    <p class="crumbs"><a href="/help/">Help</a> · {topic.data.group}</p>
    <h1 id={topic.data.legacyAnchor}>{topic.data.title}</h1>
    {
      videos.length > 0 && (
        <p class="watch-jump">
          <a href="#watch">{videos.length === 1 ? "Watch the video" : `Watch the ${videos.length} videos`}</a> for this
          topic.
        </p>
      )
    }
    <Content />
    {
      videos.length > 0 && (
        <section class="watch" aria-labelledby="watch">
          <h2 id="watch">Watch it</h2>
          <div class="vids">
            {videos.map((v) => (
              <VideoFacade {...v} />
            ))}
          </div>
          <p class="watch-note">Videos play from YouTube, which loads only when you press play.</p>
        </section>
      )
    }
    <p class="applies">Written for Silo {topic.data.appliesTo}. Something out of date? <a href="/go/new-issue">Tell us</a>.</p>
  </article>
  <nav class="pager" aria-label="More help">
    {prev ? <a class="prev" href={`/help/${prev.id}/`}><span>Previous</span>{prev.data.label}</a> : <span />}
    {next && <a class="next" href={`/help/${next.id}/`}><span>Next</span>{next.data.label}</a>}
  </nav>
  <ShotViewer />
</HelpLayout>

<style>
  .crumbs {
    margin: 0 0 8px;
    color: var(--muted);
    font-size: 0.92rem;
  }
  .crumbs a {
    color: var(--primary-text);
  }
  h1 {
    font-size: var(--text-3xl);
    line-height: var(--leading-tight);
    margin-bottom: 20px;
  }
  /* Old-anchor arrivals (#crash-triage-h) and in-page links clear the sticky header. */
  h1,
  .prose :global(h2) {
    scroll-margin-top: 88px;
  }
  .prose :global(h2) {
    font-size: 1.45rem;
    margin: 36px 0 10px;
  }
  .prose :global(p),
  .prose :global(li) {
    max-width: 70ch;
  }
  .prose :global(li) {
    margin: 4px 0;
  }
  /* A screenshot's paragraph uses the whole column, not the 70ch text measure. */
  .prose :global(p:has(> a.zoom)) {
    max-width: none;
    margin: 24px 0;
  }
  .prose :global(a.zoom) {
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow:
      0 0 0 1px var(--border),
      var(--shadow-1, 0 1px 3px rgb(0 0 0 / 0.12));
  }
  .prose :global(a.zoom img) {
    display: block;
    width: 100%;
    height: auto;
  }
  .prose :global(a) {
    color: var(--primary-text);
  }
  .prose :global(code) {
    background: var(--sunken);
    padding: 1px 5px;
    border-radius: 4px;
    overflow-wrap: anywhere;
  }
  .prose :global(blockquote) {
    margin: 20px 0;
    padding: 12px 18px;
    border-left: 4px solid var(--primary);
    background: var(--sunken);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  }
  .prose :global(blockquote p) {
    margin: 0;
  }
  .watch-jump {
    margin: -8px 0 20px;
    font-size: 0.95rem;
  }
  .vids {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 28px 24px;
    margin-top: 16px;
  }
  .watch-note {
    margin: 16px 0 0;
    color: var(--muted);
    font-size: 0.9rem;
  }
  .applies {
    margin-top: 40px;
    color: var(--muted);
    font-size: 0.9rem;
  }
  .pager {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px;
    margin-top: 24px;
    padding-top: 20px;
    border-top: 1px solid var(--border);
  }
  .pager a {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 10px 14px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    text-decoration: none;
    color: var(--text);
    font-weight: 600;
    max-width: 48%;
  }
  .pager a span {
    font-size: 0.8rem;
    font-weight: 400;
    color: var(--muted);
  }
  .pager .next {
    margin-left: auto;
    text-align: right;
  }
</style>
