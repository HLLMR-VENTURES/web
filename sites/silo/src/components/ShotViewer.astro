---
/**
 * Full-size screenshot viewer. Every `a[data-zoom]` on the page links straight to the full-size
 * image (the no-script fallback); with scripts it opens here instead: the shot fits the window,
 * a click or Z shows it at the screen's real pixels, ← → step through the page's shots, and Esc,
 * the close button or a click beside the image closes it. A native modal <dialog> keeps focus
 * inside; focus goes back to the link that opened it. Used by the home page and the Help topics.
 */
---

<dialog class="viewer" aria-label="Screenshot" data-viewer>
  <div class="tools">
    <p class="count" aria-live="polite" data-count></p>
    <button type="button" class="tool" data-zoom-toggle aria-pressed="false">Actual size</button>
    <button type="button" class="tool nav" data-prev aria-label="Previous screenshot">←</button>
    <button type="button" class="tool nav" data-next aria-label="Next screenshot">→</button>
    <button type="button" class="tool close" data-close aria-label="Close" autofocus>✕</button>
  </div>
  <div class="stage" data-stage></div>
  <p class="caption" data-caption></p>
</dialog>

<style>
  .viewer {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgb(12 12 10 / 0.97);
    color: #f4f1ea;
  }
  .viewer[open] {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: auto minmax(0, 1fr) auto;
  }
  .viewer::backdrop {
    background: rgb(12 12 10 / 0.6);
  }
  @media (prefers-reduced-motion: no-preference) {
    .viewer[open] {
      animation: viewer-in 140ms ease-out;
    }
    @keyframes viewer-in {
      from {
        opacity: 0;
      }
    }
  }
  .tools {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 12px;
  }
  .count {
    margin: 0 auto 0 4px;
    white-space: nowrap;
    font-size: 0.9rem;
    opacity: 0.85;
  }
  .tool {
    min-width: 44px;
    min-height: 44px;
    padding: 0 14px;
    border: 1px solid rgb(255 255 255 / 0.28);
    border-radius: var(--radius-sm, 6px);
    background: rgb(255 255 255 / 0.08);
    color: inherit;
    font: inherit;
    font-weight: 600;
    white-space: nowrap;
    cursor: pointer;
  }
  .tool:hover {
    background: rgb(255 255 255 / 0.16);
  }
  .tool:focus-visible {
    outline: 3px solid #f4f1ea;
    outline-offset: 2px;
  }
  .tool[hidden] {
    display: none;
  }
  .stage {
    min-height: 0;
    overflow: auto;
    display: flex;
    /* `safe` keeps an enlarged image scrollable to its top-left edge instead of cut off. */
    align-items: safe center;
    justify-content: safe center;
    padding: 0 12px;
    cursor: zoom-out;
  }
  /* The <img> is created by the script (an empty one wouldn't be valid HTML), so these are global. */
  .stage :global(.full) {
    display: block;
    flex: none;
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 6px;
    cursor: zoom-in;
  }
  /* Actual size: the JS sets the width to the image's pixels at this screen's density. */
  .stage.zoomed :global(.full) {
    max-width: none;
    max-height: none;
    border-radius: 0;
    cursor: zoom-out;
  }
  .caption {
    margin: 0 auto;
    padding: 10px 16px 14px;
    max-width: 90ch;
    font-size: 0.92rem;
    line-height: 1.45;
    text-align: center;
    opacity: 0.88;
  }
  :global(html:has(dialog.viewer[open])) {
    overflow: hidden;
  }

  /* The links that open the viewer (home page figures and Help images). Global: the Help ones are
     written into the built HTML by src/lib/help-images.mjs. The hint shows on hover and focus, and
     always on touch screens. */
  :global(a.zoom) {
    position: relative;
    display: block;
    cursor: zoom-in;
  }
  :global(a.zoom:focus-visible) {
    outline: var(--focus-width, 2px) solid var(--focus);
    outline-offset: -4px;
  }
  :global(.zoom-hint) {
    position: absolute;
    right: 12px;
    bottom: 12px;
    padding: 6px 12px;
    border-radius: 999px;
    background: rgb(20 20 18 / 0.82);
    color: #f4f1ea;
    font-size: 0.85rem;
    font-weight: 600;
    line-height: 1.2;
    opacity: 0;
  }
  :global(a.zoom:hover .zoom-hint),
  :global(a.zoom:focus-visible .zoom-hint) {
    opacity: 1;
  }
  @media (hover: none) {
    :global(.zoom-hint) {
      opacity: 1;
    }
  }
</style>

<script>
  const dialog = document.querySelector<HTMLDialogElement>("[data-viewer]");
  const links = [...document.querySelectorAll<HTMLAnchorElement>("a[data-zoom]")];

  if (dialog && links.length && typeof dialog.showModal === "function") {
    const stage = dialog.querySelector<HTMLElement>("[data-stage]")!;
    const img = stage.appendChild(document.createElement("img"));
    img.className = "full";
    img.decoding = "async";
    const caption = dialog.querySelector<HTMLElement>("[data-caption]")!;
    const count = dialog.querySelector<HTMLElement>("[data-count]")!;
    const toggle = dialog.querySelector<HTMLButtonElement>("[data-zoom-toggle]")!;
    const prev = dialog.querySelector<HTMLButtonElement>("[data-prev]")!;
    const next = dialog.querySelector<HTMLButtonElement>("[data-next]")!;
    let index = 0;
    let opener: HTMLAnchorElement | null = null;

    prev.hidden = next.hidden = links.length < 2;

    const altOf = (a: HTMLAnchorElement) => a.querySelector("img")?.getAttribute("alt") ?? "";

    /** Fit the window, or show the shot at the screen's real pixels (scrollable). */
    const setZoom = (on: boolean, focus?: { x: number; y: number }) => {
      if (on && !img.naturalWidth) return;
      // Measure the fitted size before the zoomed class lifts the limits.
      const fitWidth = img.getBoundingClientRect().width;
      stage.classList.toggle("zoomed", on);
      toggle.setAttribute("aria-pressed", String(on));
      toggle.textContent = on ? "Fit to window" : "Actual size";
      if (!on) {
        img.style.removeProperty("width");
        return;
      }
      // One image pixel per screen pixel; never smaller than 1.5x the fitted size, so a small
      // window still gets a real enlargement.
      const width = Math.max(img.naturalWidth / (window.devicePixelRatio || 1), fitWidth * 1.5);
      img.style.width = `${Math.round(width)}px`;
      // Keep the clicked point (or the centre) in the middle of the view.
      const fx = focus ? focus.x : 0.5;
      const fy = focus ? focus.y : 0.5;
      stage.scrollLeft = fx * img.offsetWidth - stage.clientWidth / 2;
      stage.scrollTop = fy * img.offsetHeight - stage.clientHeight / 2;
    };

    const show = (i: number) => {
      index = (i + links.length) % links.length;
      const a = links[index];
      setZoom(false);
      img.src = a.href;
      img.alt = altOf(a);
      caption.textContent = altOf(a);
      count.textContent = links.length > 1 ? `${index + 1} of ${links.length}` : "";
    };

    for (const [i, a] of links.entries()) {
      a.addEventListener("click", (e) => {
        if (e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
        e.preventDefault();
        opener = a;
        show(i);
        dialog.showModal();
      });
    }

    toggle.addEventListener("click", () => setZoom(!stage.classList.contains("zoomed")));
    prev.addEventListener("click", () => show(index - 1));
    next.addEventListener("click", () => show(index + 1));
    dialog.querySelector("[data-close]")!.addEventListener("click", () => dialog.close());

    img.addEventListener("click", (e) => {
      e.stopPropagation();
      const zoomed = stage.classList.contains("zoomed");
      const r = img.getBoundingClientRect();
      setZoom(!zoomed, { x: (e.clientX - r.left) / r.width, y: (e.clientY - r.top) / r.height });
    });
    // A click beside the image (the dark area) closes, as the backdrop would.
    stage.addEventListener("click", (e) => {
      if (e.target === stage) dialog.close();
    });

    dialog.addEventListener("keydown", (e) => {
      if (e.target instanceof HTMLButtonElement && (e.key === "Enter" || e.key === " ")) return;
      // At actual size the arrow keys pan the image instead.
      const zoomed = stage.classList.contains("zoomed");
      const pan: Record<string, [number, number]> = { ArrowLeft: [-1, 0], ArrowRight: [1, 0], ArrowUp: [0, -1], ArrowDown: [0, 1] };
      if (zoomed && e.key in pan) stage.scrollBy(pan[e.key][0] * 120, pan[e.key][1] * 120);
      else if (e.key === "ArrowLeft" && links.length > 1) show(index - 1);
      else if (e.key === "ArrowRight" && links.length > 1) show(index + 1);
      else if (e.key === "z" || e.key === "Z") setZoom(!stage.classList.contains("zoomed"));
      else return;
      e.preventDefault();
    });

    dialog.addEventListener("close", () => {
      setZoom(false);
      img.removeAttribute("src");
      opener?.focus();
      opener = null;
    });
  }
</script>
