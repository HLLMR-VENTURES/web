---
/**
 * Site footer: the tagline with the HLLMR GAMING endorsement, four link columns and the disclosure
 * line. The endorsement is plain text (ADR-0015 D4): the Silo glyph is never locked up with the HLLMR
 * arms, and legal naming stays HLLMR Ventures LLC (D5). Discord goes through the /discord
 * redirect so an invite change is one line in redirects.json. Columns list only pages that exist.
 */
import glyph from "../assets/brand/silo-glyph.svg";
import { LINKS, OWNER } from "../lib/site";

const columns = [
  {
    title: "Product",
    links: [
      { href: "/download/", label: "Download" },
      { href: "/browse/", label: "Browse mods" },
      { href: "/trust/", label: "Trust" },
      { href: "/changelog/", label: "What's new" },
    ],
  },
  {
    title: "Help",
    links: [
      { href: "/help/", label: "Help" },
      { href: "/community/", label: "Community" },
      { href: LINKS.discord, label: "Discord" },
      { href: LINKS.discussions, label: "Discussions", external: true },
      { href: LINKS.newIssue, label: "Report a bug", external: true },
    ],
  },
  {
    title: "Mod authors",
    links: [
      { href: "/trust/#authors-h", label: "For mod authors" },
      { href: "/legal/copyright-takedown.html", label: "Copyright and takedown" },
    ],
  },
  {
    title: "Company",
    links: [
      { href: LINKS.hllmr, label: "HLLMR Ventures", external: true },
      { href: LINKS.source, label: "Source code", external: true },
      { href: "/legal/", label: "Legal" },
      { href: "/legal/privacy-policy.html", label: "Privacy" },
    ],
  },
];
---

<footer class="ft">
  <div class="in">
    <div class="about">
      <img src={glyph.src} width="32" height="32" alt="" />
      <div>
        <p>Silo is a free, open-source mod manager for Farming Simulator 25.</p>
        <p class="endorse">Silo · a <a href={LINKS.gaming} rel="noopener">HLLMR GAMING</a> product</p>
      </div>
    </div>
    {
      columns.map((c) => (
        <nav class="col" aria-label={c.title}>
          <h2>{c.title}</h2>
          <ul>
            {c.links.map((l) => (
              <li>{l.external ? <a href={l.href} rel="noopener">{l.label}</a> : <a href={l.href}>{l.label}</a>}</li>
            ))}
          </ul>
        </nav>
      ))
    }
    <p class="note">
      Silo is made by {OWNER}. It is not affiliated with GIANTS Software. Farming Simulator is a trademark of its
      respective owner. Silo indexes and verifies mods; it doesn't host them.
    </p>
  </div>
</footer>

<style>
  .ft {
    border-top: 1px solid var(--border);
    background: var(--surface);
  }
  .in {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
    gap: 28px 32px;
    max-width: var(--maxw-docs);
    margin: 0 auto;
    padding: 44px var(--gutter) 40px;
  }
  .about {
    grid-column: 1 / -1;
    display: flex;
    gap: 12px;
    align-items: center;
  }
  .about p {
    margin: 0;
    color: var(--muted);
  }
  .about .endorse {
    margin-top: 2px;
    font-size: 0.9rem;
  }
  .endorse a {
    color: var(--primary-text);
    font-weight: 600;
  }
  .col h2 {
    font-family: var(--font-ui);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--earth-text);
    margin: 0 0 10px;
  }
  .col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 2px;
  }
  .col a {
    display: inline-block;
    padding: 6px 0;
    color: var(--text);
    text-decoration: none;
    font-size: 0.95rem;
  }
  .col a:hover {
    text-decoration: underline;
    color: var(--primary-text);
  }
  .note {
    grid-column: 1 / -1;
    margin: 8px 0 0;
    padding-top: 20px;
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: 0.85rem;
    line-height: 1.5;
  }
</style>
