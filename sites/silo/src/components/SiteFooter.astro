---
/** Site footer at parity with the old nav.js footer; Discord goes through the /discord redirect. */
import Logo from "./Logo.astro";
import { LINKS, OWNER } from "../lib/site";

const links = [
  { href: "/", label: "Home" },
  { href: "/browse/", label: "Browse" },
  { href: "/help/", label: "Help" },
  { href: LINKS.discussions, label: "Community", external: true },
  { href: LINKS.discord, label: "Discord" },
  { href: "/trust/", label: "Trust" },
  { href: "/legal/", label: "Legal" },
  { href: LINKS.source, label: "Source", external: true },
];
---

<footer class="ft">
  <div class="in">
    <a class="brand" href="/" aria-label="Silo home"><Logo /></a>
    <span class="sp"></span>
    <nav class="links" aria-label="Footer">
      {links.map((l) => (l.external ? <a href={l.href} rel="noopener">{l.label}</a> : <a href={l.href}>{l.label}</a>))}
    </nav>
    <p class="note">
      Mods for Farming Simulator. Silo is not affiliated with GIANTS Software. Silo indexes and verifies mods; it
      doesn't host them. © {OWNER}.
    </p>
  </div>
</footer>

<style>
  .ft {
    border-top: 1px solid var(--border);
    margin-top: 48px;
  }
  .in {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    flex-wrap: wrap;
    max-width: var(--maxw-docs);
    margin: 0 auto;
    padding: 22px 20px 26px;
  }
  .brand {
    display: flex;
    align-items: center;
    text-decoration: none;
  }
  .sp {
    flex: 1 1 auto;
  }
  .links {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }
  .links a {
    color: var(--muted);
    text-decoration: none;
    font-size: 13px;
  }
  .links a:hover {
    color: var(--text);
    text-decoration: underline;
  }
  .note {
    flex: 1 1 100%;
    color: var(--muted);
    font-size: 12px;
    line-height: 1.5;
    margin: 2px 0 0;
  }
</style>
