---
/**
 * Static fallback for a redirect that nginx normally answers itself (302/301). It only matters if
 * the server config lags behind redirects.json; it is noindex and works without JavaScript.
 */
interface Props {
  to: string;
  label?: string;
}
const { to, label = to } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={`0; url=${to}`} />
    <link rel="canonical" href={to} />
    <title>Redirecting…</title>
  </head>
  <body>
    <p>Redirecting to <a href={to}>{label}</a>…</p>
  </body>
</html>
