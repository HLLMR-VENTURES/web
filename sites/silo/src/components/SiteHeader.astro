---
/**
 * Site header, rendered statically. The current section is marked at build time with
 * aria-current. Below 720 px the links fold behind a Menu button; without JavaScript they stay
 * visible and simply wrap.
 */
import ThemeToggle from "@hllmr/design/components/ThemeToggle.astro";
import Logo from "./Logo.astro";
import { THEME_STORAGE_KEY } from "../lib/site";

const path = Astro.url.pathname;
const isHome = path === "/" || path === "/index.html";
const nav = [
  { href: "/browse/", label: "Browse mods" },
  { href: "/help/", label: "Help" },
  { href: "/trust/", label: "Trust" },
];
---

<header class="hd">
  <div class="in">
    <a class="brand" href="/" aria-label="Silo home"><Logo /></a>
    <button class="menu" type="button" aria-expanded="false" aria-controls="site-nav" hidden>Menu</button>
    <nav class="nav" id="site-nav" aria-label="Site">
      {
        nav.map((l) => (
          <a href={l.href} aria-current={path.startsWith(l.href) ? "page" : undefined}>
            {l.label}
          </a>
        ))
      }
      <a class="cta" href={isHome ? "#download" : "/#download"}>Download</a>
      <ThemeToggle storageKey={THEME_STORAGE_KEY} class="tog" />
    </nav>
  </div>
</header>

<script>
  // Mobile disclosure: the button is revealed only when this script runs.
  const btn = document.querySelector<HTMLButtonElement>(".hd .menu");
  const nav = document.querySelector<HTMLElement>("#site-nav");
  if (btn && nav) {
    btn.hidden = false;
    document.documentElement.classList.add("has-menu");
    btn.addEventListener("click", () => {
      const open = btn.getAttribute("aria-expanded") !== "true";
      btn.setAttribute("aria-expanded", String(open));
      nav.toggleAttribute("data-open", open);
    });
    nav.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && btn.getAttribute("aria-expanded") === "true") {
        btn.setAttribute("aria-expanded", "false");
        nav.removeAttribute("data-open");
        btn.focus();
      }
    });
  }
</script>

<style>
  .hd {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    background: color-mix(in srgb, var(--surface) 92%, transparent);
    backdrop-filter: saturate(1.4) blur(10px);
    -webkit-backdrop-filter: saturate(1.4) blur(10px);
    border-bottom: 1px solid var(--border);
  }
  .in {
    display: flex;
    align-items: center;
    gap: 12px 20px;
    max-width: var(--maxw-docs);
    margin: 0 auto;
    padding: 10px var(--gutter);
    flex-wrap: wrap;
  }
  .brand {
    display: flex;
    align-items: center;
    text-decoration: none;
    color: var(--text);
    margin-right: auto;
    padding: 4px 0;
  }
  .nav {
    display: flex;
    align-items: center;
    gap: 4px;
    flex-wrap: wrap;
  }
  .nav a {
    color: var(--text);
    text-decoration: none;
    font-size: 15px;
    font-weight: 600;
    padding: 10px 12px;
    border-radius: var(--radius-sm);
  }
  .nav a:hover {
    background: color-mix(in srgb, var(--primary) 10%, transparent);
  }
  .nav a[aria-current="page"] {
    color: var(--primary-text);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 6px;
  }
  .nav a.cta {
    color: var(--on-primary);
    background: var(--primary);
    margin-left: 8px;
    padding: 10px 18px;
  }
  .nav a.cta:hover {
    background: var(--primary-hover);
  }
  .nav :global(.tog),
  .menu {
    border: 1px solid var(--border);
    background: var(--raised);
    color: var(--text);
    min-width: 44px;
    height: 44px;
    border-radius: var(--radius-sm);
    font: 600 15px var(--font-ui);
    cursor: pointer;
    margin-left: 4px;
  }
  .menu {
    padding: 0 14px;
  }
  .menu[hidden] {
    display: none;
  }
  @media (min-width: 720px) {
    .menu {
      display: none;
    }
  }
  @media (max-width: 719.98px) {
    :global(.has-menu) .nav:not([data-open]) {
      display: none;
    }
    .nav {
      flex: 1 1 100%;
      flex-direction: column;
      align-items: stretch;
      padding-bottom: 8px;
    }
    .nav a.cta {
      margin: 6px 0 0;
      text-align: center;
    }
    .nav :global(.tog) {
      align-self: flex-start;
      margin: 6px 0 0;
    }
  }
</style>
