---
/**
 * Site header, rendered statically (ported from the old runtime-injected nav.js). The current
 * section is marked at build time with aria-current, so it works without JavaScript.
 */
import ThemeToggle from "@hllmr/design/components/ThemeToggle.astro";
import Logo from "./Logo.astro";
import { LINKS, THEME_STORAGE_KEY } from "../lib/site";

const path = Astro.url.pathname;
const isHome = path === "/" || path === "/index.html";
const nav = [
  { href: "/browse/", label: "Browse" },
  { href: "/help/", label: "Help" },
  { href: "/trust/", label: "Trust" },
];
---

<header class="hd">
  <div class="in">
    <a class="brand" href="/" aria-label="Silo home"><Logo /></a>
    <span class="sp"></span>
    <nav class="nav" aria-label="Site">
      {
        nav.map((l) => (
          <a href={l.href} aria-current={path.startsWith(l.href) ? "page" : undefined}>
            {l.label}
          </a>
        ))
      }
      <a href={LINKS.source} rel="noopener">Source</a>
      <a class="cta" href={isHome ? "#download" : "/#download"}>Get Silo</a>
      <ThemeToggle storageKey={THEME_STORAGE_KEY} class="tog" />
    </nav>
  </div>
</header>

<style>
  .hd {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    background: color-mix(in srgb, var(--surface) 90%, transparent);
    backdrop-filter: saturate(1.4) blur(10px);
    -webkit-backdrop-filter: saturate(1.4) blur(10px);
    border-bottom: 1px solid var(--border);
  }
  .in {
    display: flex;
    align-items: center;
    gap: 14px;
    max-width: var(--maxw-docs);
    margin: 0 auto;
    padding: 11px 20px;
    flex-wrap: wrap;
  }
  .brand {
    display: flex;
    align-items: center;
    text-decoration: none;
    color: var(--text);
  }
  .sp {
    flex: 1 1 auto;
  }
  .nav {
    display: flex;
    align-items: center;
    gap: 4px;
    flex-wrap: wrap;
  }
  .nav a {
    color: var(--muted);
    text-decoration: none;
    font-size: 14px;
    font-weight: 600;
    padding: 7px 11px;
    border-radius: var(--radius-sm);
  }
  .nav a:hover {
    color: var(--text);
    background: color-mix(in srgb, var(--primary) 10%, transparent);
  }
  .nav a[aria-current="page"] {
    color: var(--primary);
  }
  .nav a.cta {
    color: var(--on-primary);
    background: var(--primary);
    border: 1px solid var(--primary);
  }
  .nav a.cta:hover {
    background: var(--primary-hover);
    color: var(--on-primary);
  }
  .nav :global(.tog) {
    border: 1px solid var(--border);
    background: var(--raised);
    color: var(--text);
    width: 34px;
    height: 34px;
    border-radius: var(--radius-sm);
    font-size: 15px;
    line-height: 1;
    cursor: pointer;
  }
  .nav :global(.tog:hover) {
    border-color: color-mix(in srgb, var(--primary) 45%, var(--border));
  }
</style>
