---
/** 404 (served by nginx `error_page 404 /404.html`). */
import BaseLayout from "../layouts/BaseLayout.astro";
import { NAME } from "../lib/site";
---

<BaseLayout title={`Not found · ${NAME}`} description="This page does not exist on dhellmer.com." noindex>
  <section class="nf wrap">
    <p class="k">404</p>
    <div>
      <h1>Nothing here.</h1>
      <p>The page you asked for isn't here. The essays live on hllmr.com; everything else is one of these.</p>
      <p class="links">
        <a class="btn btn-primary" href="/">Home</a>
        <a class="btn btn-ghost" href="/writing/">Writing</a>
        <a class="btn btn-ghost" href="/ventures/">Ventures</a>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .nf {
    padding-top: var(--space-9);
    border-bottom: 1px solid var(--text);
    padding-bottom: var(--space-7);
  }
  .k {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    color: var(--accent);
    margin: 0 0 var(--space-4);
  }
  h1 {
    font-family: var(--font-display);
    font-weight: 700;
    font-stretch: 75%;
    text-transform: uppercase;
    font-size: clamp(3rem, 1.8rem + 5vw, 6.5rem);
    line-height: 0.88;
    margin-bottom: var(--space-5);
  }
  p {
    color: var(--muted);
    max-width: 56ch;
  }
  .links {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: var(--space-5);
  }
  .links :global(.btn) {
    border-radius: 0;
  }
</style>
