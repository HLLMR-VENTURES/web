---
/**
 * Home: a person first. Name and a short human introduction with the portrait, a dated "Now"
 * snapshot, paths into Story, Experience, Projects and Writing, the career at a glance, and a
 * selection (not a feed) of ventures and essays. Redesign brief v0.1 (2026-10-19), direction B.
 * Every fact here is already owner-approved (LinkedIn export, founder note); the positioning line,
 * the introduction and the Now snapshot are new copy the owner approves at merge.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import Entry from "../components/Entry.astro";
import Portrait from "../components/Portrait.astro";
import StageTag from "../components/StageTag.astro";
import { ESSAYS, PROJECT_LINKS, VENTURE_LINKS, shortDate } from "../lib/hllmr";
import { SKILLS } from "../lib/cv";
import { HUB, LOCALITY, NAME, PROFILES, abs } from "../lib/site";

/** The Now snapshot's date. Update it whenever the snapshot changes. */
const NOW_DATE = { iso: "2026-10", label: "October 2026" };

const NOW = [
  { k: "Engineering", t: "Senior applications engineer, building automation", d: "Design-build and plan/spec BAS engineering, plus internal software and training for the engineering team." },
  { k: "Building", t: "Software of my own, with AI agents", d: "Silo, stratum-dsp and Writwall under HLLMR Ventures, held to the rule that nothing is done until it has been seen working." },
  { k: "Music", t: "Still DJing", d: "Thirty years on, and an events venture of its own is in the idea stage." },
  { k: "This site", t: "Becoming a public record", d: "Story, projects and an archive, added chapter by chapter." },
];

const PATHS = [
  { href: "/about/", k: "Story", n: "01", t: "About", d: "A short bio, and the longer story in chapters." },
  { href: "/cv/", k: "Experience", n: "2004–", t: "Experience", d: "Twenty years from field technician to division head, and the businesses in between." },
  { href: "/ventures/", k: "Projects", n: String(PROJECT_LINKS.length), t: "Projects", d: "What I've built and started, from my side of it." },
  { href: "/writing/", k: "Writing", n: String(ESSAYS.length), t: "Writing", d: "Essays in my own voice." },
];

const ERAS = [
  { k: "1998–2000", t: "U.S. Navy nuclear power training", d: "Where you assume nothing works until you have watched it work." },
  {
    k: "2004–2017",
    t: "Building automation and low-voltage systems",
    d: "From security and fire installs to leading a building automation division: SCIFs, government data centers, hospitals, airports and an FAA control center.",
  },
  {
    k: "2007–2025",
    t: "Businesses built and run",
    d: "An event-services company, a consultancy, a freeze-dried food manufacturer with national distribution and a team of twelve, and a stretch behind the wheel of a truck.",
  },
  {
    k: "2025–",
    t: "Building systems, software and applied AI",
    d: "Senior applications engineering in BAS, internal software for engineering teams, and HLLMR Ventures.",
  },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": abs("/#person", Astro.site),
  name: NAME,
  url: abs("/", Astro.site),
  jobTitle: "Founder & Principal Engineer",
  worksFor: { "@type": "Organization", name: "HLLMR Ventures LLC", url: HUB },
  homeLocation: { "@type": "Place", name: LOCALITY },
  knowsAbout: [...SKILLS],
  sameAs: PROFILES.filter((p) => p.label === "LinkedIn" && p.href).map((p) => p.href),
};
---

<BaseLayout
  title={`${NAME} · Engineer, DJ, builder of businesses`}
  description="David Hellmer: engineer, DJ and builder of businesses in Dallas–Fort Worth. Navy nuclear power training, twenty years in building systems, businesses built and run, and now software built with AI agents."
  ogType="profile"
  jsonLd={jsonLd}
>
  <section class="hero wrap" aria-labelledby="name">
    <div class="intro">
      <p class="idx"><span><b>01</b> Introduction</span><span>{LOCALITY}</span><span>Now: {NOW_DATE.label}</span></p>
      <h1 id="name" class="display">David<br />Hellmer</h1>
      <p class="pos">Engineer. DJ. <span>Builder of businesses.</span></p>
      <p class="lead">
        For more than twenty years I've made systems behave: building controls in laboratories, data centers and an FAA
        control center; a freeze-dried food company built to national distribution; and DJ booths for most of that time.
        Now I build software with AI agents, held to the rule I learned in the Navy's nuclear program: nothing works until
        you have watched it work.
      </p>
    </div>
    <div class="photo">
      <Portrait caption="Photographed November 2025" />
    </div>
  </section>

  <nav class="paths wrap" aria-label="Sections">
    {
      PATHS.map((p) => (
        <a class="path" href={p.href}>
          <span class="idx">
            <b>{p.k}</b> · {p.n}
          </span>
          <span class="pt">{p.t}</span>
          <span class="pd">{p.d}</span>
        </a>
      ))
    }
  </nav>

  <div class="log wrap">
    <Entry no={NOW_DATE.label} label="Now" id="now">
      <h2 id="now">What I'm doing now.</h2>
      <ul class="rows">
        {
          NOW.map((n) => (
            <li class="row">
              <div>
                <span class="f">{n.k}</span>
                <span class="t">{n.t}</span>
                <p class="d">{n.d}</p>
              </div>
            </li>
          ))
        }
      </ul>
      <p class="asof idx">As of <time datetime={NOW_DATE.iso}>{NOW_DATE.label}</time></p>
    </Entry>

    <Entry no="1998–" label="So far" id="before">
      <h2 id="before">Navy, buildings, businesses, software.</h2>
      <ol class="rows">
        {
          ERAS.map((e) => (
            <li class="row">
              <div>
                <span class="f">{e.k}</span>
                <span class="t">{e.t}</span>
                <p class="d">{e.d}</p>
              </div>
            </li>
          ))
        }
      </ol>
      <a class="more" href="/cv/">The full experience</a>
    </Entry>

    <Entry no={String(VENTURE_LINKS.length)} label="Ventures" id="ventures">
      <h2 id="ventures">What I'm building.</h2>
      <ul class="rows">
        {
          VENTURE_LINKS.map((v) => (
            <li class="row">
              <div>
                <span class="f">{v.field}</span>
                {v.href ? (
                  <a class="t" href={v.href}>
                    {v.name}
                  </a>
                ) : (
                  <span class="t">{v.name}</span>
                )}
                <p class="d">{v.line}</p>
              </div>
              <div class="meta">
                <StageTag stage={v.stage} />
                {v.href ? (
                  <a class="ext" href={v.href}>
                    {v.host}
                  </a>
                ) : (
                  <span>site to come</span>
                )}
              </div>
            </li>
          ))
        }
      </ul>
      <a class="more" href="/ventures/">All projects</a>
    </Entry>

    <Entry no={String(ESSAYS.length)} label="Writing" id="writing">
      <h2 id="writing">What I've written.</h2>
      <ul class="rows">
        {
          ESSAYS.slice(0, 3).map((e) => (
            <li class="row">
              <div>
                <span class="f">{e.kind}</span>
                <a class="t" href={e.href}>
                  {e.title}
                </a>
                <p class="d">{e.description}</p>
              </div>
              <div class="meta">
                <time datetime={e.published}>{shortDate(e.published)}</time>
                <span>hllmr.com</span>
              </div>
            </li>
          ))
        }
      </ul>
      <a class="more" href="/writing/">All writing</a>
    </Entry>
  </div>
</BaseLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr);
    gap: var(--space-8);
    align-items: end;
    padding-top: var(--space-8);
    padding-bottom: var(--space-7);
  }
  .intro .idx {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 24px;
    margin: 0 0 var(--space-5);
  }
  h1 {
    font-size: clamp(4.2rem, 1.6rem + 10vw, 10rem);
    margin-left: -0.03em;
  }
  .pos {
    font-family: var(--font-display);
    font-weight: 600;
    font-stretch: 85%;
    text-transform: uppercase;
    font-size: clamp(1.4rem, 1.1rem + 1.2vw, 2rem);
    line-height: 1.1;
    margin: var(--space-6) 0 var(--space-5);
  }
  .pos span {
    color: var(--accent);
  }
  .lead {
    font-size: clamp(1.05rem, 1rem + 0.3vw, 1.2rem);
    line-height: 1.65;
    max-width: 60ch;
    margin: 0;
  }

  .paths {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid var(--text);
    border-bottom: 1px solid var(--text);
    margin-bottom: var(--space-4);
  }
  .path {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: var(--space-5) var(--space-5) var(--space-6) 0;
    text-decoration: none;
    color: var(--text);
    border-right: 1px solid var(--rule);
    transition: background var(--dur-fast);
  }
  .path + .path {
    padding-left: var(--space-5);
  }
  .path:last-child {
    border-right: 0;
  }
  .path:hover {
    background: var(--surface);
    color: var(--text);
  }
  .path:hover .pt {
    color: var(--accent);
  }
  .pt {
    font-family: var(--font-display);
    font-weight: 700;
    font-stretch: 75%;
    text-transform: uppercase;
    font-size: 1.9rem;
    line-height: 0.95;
    transition: color var(--dur-fast);
  }
  .pd {
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.5;
  }
  .asof {
    margin: var(--space-4) 0 0;
  }

  @media (max-width: 900px) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-6);
      padding-top: var(--space-6);
    }
    .photo {
      max-width: 420px;
    }
    .paths {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .path:nth-child(2) {
      border-right: 0;
    }
    .path:nth-child(-n + 2) {
      border-bottom: 1px solid var(--rule);
    }
    .path:nth-child(3) {
      padding-left: 0;
    }
  }
</style>
