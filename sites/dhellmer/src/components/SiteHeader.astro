---
/** Site header: name and domain as the home link (mono), the navigation (current section marked at build time), theme toggle. */
import ThemeToggle from "@hllmr/design/components/ThemeToggle.astro";
import { NAME, NAV, THEME_STORAGE_KEY } from "../lib/site";

const path = Astro.url.pathname;
const current = (href: string) => path.startsWith(href);
---

<header class="hd">
  <div class="in wrap">
    <a class="brand" href="/" aria-label={`${NAME}, home`}>
      <span class="nm">{NAME}</span><span class="sl" aria-hidden="true">/</span><span class="dom" aria-hidden="true">dhellmer.com</span>
    </a>
    <span class="sp"></span>
    <nav class="nav" aria-label="Site">
      {
        NAV.map((l) => (
          <a href={l.href} aria-current={current(l.href) ? "page" : undefined}>
            {l.label}
          </a>
        ))
      }
    </nav>
    <ThemeToggle storageKey={THEME_STORAGE_KEY} class="tog" />
  </div>
</header>

<style>
  .hd {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--rule);
  }
  .in {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    padding-top: 16px;
    padding-bottom: 16px;
    flex-wrap: wrap;
  }
  .brand {
    display: inline-flex;
    align-items: baseline;
    gap: 10px;
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .sl {
    color: var(--accent);
  }
  .dom {
    color: var(--muted);
  }
  .sp {
    flex: 1;
  }
  .nav {
    display: flex;
    gap: 24px;
    flex-wrap: wrap;
  }
  .nav a {
    font-weight: 500;
    font-size: 0.95rem;
    color: var(--text);
    text-decoration: none;
    padding: 4px 0;
    border-bottom: 2px solid transparent;
    transition: border-color var(--dur-fast);
  }
  .nav a:hover {
    border-bottom-color: var(--rule);
    color: var(--text);
  }
  .nav a[aria-current="page"] {
    border-bottom-color: var(--accent);
  }
  :global(.theme-toggle) {
    width: 34px;
    height: 34px;
    border: 1px solid var(--rule);
    background: transparent;
    color: var(--text);
    border-radius: 0;
    cursor: pointer;
    font-size: 1rem;
  }
  :global(.theme-toggle:hover) {
    border-color: var(--accent);
  }
  @media (max-width: 760px) {
    .dom,
    .sl {
      display: none;
    }
    .nav {
      order: 3;
      width: 100%;
      flex-wrap: nowrap;
      justify-content: space-between;
      gap: 12px;
      overflow-x: auto;
      scrollbar-width: none;
    }
    .nav a {
      font-size: 0.88rem;
    }
  }
</style>
