---
/** Site header: the name as the home link, the navigation (current section marked at build time), theme toggle. */
import ThemeToggle from "@hllmr/design/components/ThemeToggle.astro";
import { NAME, NAV, THEME_STORAGE_KEY } from "../lib/site";

const path = Astro.url.pathname;
const current = (href: string) => path.startsWith(href);
---

<header class="hd">
  <div class="in wrap">
    <a class="brand" href="/" aria-label={`${NAME}, home`}>
      <span class="mono" aria-hidden="true">dh</span>
      <span class="nm">{NAME}</span>
    </a>
    <span class="sp"></span>
    <nav class="nav" aria-label="Site">
      {
        NAV.map((l) => (
          <a href={l.href} aria-current={current(l.href) ? "page" : undefined}>
            {l.label}
          </a>
        ))
      }
    </nav>
    <ThemeToggle storageKey={THEME_STORAGE_KEY} class="tog" />
  </div>
</header>

<style>
  .hd {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    background: color-mix(in srgb, var(--bg) 90%, transparent);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--rule);
  }
  .in {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding-top: 12px;
    padding-bottom: 12px;
    flex-wrap: wrap;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
  }
  .mono {
    display: inline-grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border: 1px solid var(--text);
    border-left: 3px solid var(--accent);
    font-family: var(--font-display);
    font-style: italic;
    font-variation-settings: "opsz" 36;
    font-weight: 500;
    font-size: 1.1rem;
    line-height: 1;
    padding-bottom: 3px;
  }
  .nm {
    font-family: var(--font-display);
    font-variation-settings: "opsz" 48;
    font-weight: 560;
    font-size: 1.12rem;
    letter-spacing: -0.01em;
  }
  .sp {
    flex: 1;
  }
  .nav {
    display: flex;
    gap: 2px;
    flex-wrap: wrap;
  }
  .nav a {
    font-family: var(--font-ui);
    font-stretch: 88%;
    font-weight: 560;
    font-size: 0.86rem;
    letter-spacing: 0.02em;
    color: var(--muted);
    text-decoration: none;
    padding: 6px 10px;
    border-bottom: 2px solid transparent;
    transition:
      color var(--dur-fast),
      border-color var(--dur-fast);
  }
  .nav a:hover {
    color: var(--text);
  }
  .nav a[aria-current="page"] {
    color: var(--text);
    border-bottom-color: var(--accent);
  }
  :global(.theme-toggle) {
    width: 34px;
    height: 34px;
    border: 1px solid var(--rule);
    background: transparent;
    color: var(--text);
    border-radius: 999px;
    cursor: pointer;
    font-size: 1rem;
  }
  :global(.theme-toggle:hover) {
    border-color: var(--accent);
  }
  @media (max-width: 720px) {
    .in {
      gap: var(--space-2);
    }
    .nav {
      order: 3;
      width: calc(100% + 16px);
      margin: 0 -8px;
      flex-wrap: nowrap;
      justify-content: space-between;
      overflow-x: auto;
      scrollbar-width: none;
    }
    .nav a {
      padding: 6px 8px;
      font-size: 0.8rem;
    }
  }
</style>
