---
/** Footer: the name, where, the index, and the colophon (revision, privacy posture, the business site). */
import { HUB, LINKS, LOCALITY, NAME, NAV, REVISION } from "../lib/site";

const year = REVISION.date === "unreleased" ? "2026" : REVISION.date.slice(0, 4);
---

<footer class="ft">
  <div class="wrap">
    <div class="close">
      <div class="who">
        <span class="sig">{NAME}</span>
        <span class="muted">{LOCALITY}</span>
      </div>
      <nav class="idx" aria-label="Footer">
        <a href="/">Home</a>
        {NAV.map((l) => <a href={l.href}>{l.label}</a>)}
        <a href="/privacy/">Privacy</a>
      </nav>
    </div>
    <p class="fine">
      <span>© {year} {NAME}</span>
      <span>Rev <a href={LINKS.siteSource} rel="noopener">{REVISION.date} · {REVISION.hash}</a></span>
      <span>Self-hosted. No cookies, no trackers.</span>
      <span>Business: <a href={HUB}>hllmr.com</a></span>
    </p>
  </div>
</footer>

<style>
  .ft {
    margin-top: var(--space-9);
    padding-bottom: var(--space-6);
  }
  .close {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: var(--space-5);
    flex-wrap: wrap;
    padding-top: var(--space-6);
    border-top: 1px solid var(--text);
  }
  .who {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .sig {
    font-family: var(--font-display);
    font-weight: 700;
    font-stretch: 75%;
    text-transform: uppercase;
    font-size: 2.6rem;
    line-height: 0.86;
  }
  .muted {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .idx {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 20px;
  }
  .idx a {
    font-size: 0.92rem;
    color: var(--text);
    text-decoration: none;
  }
  .idx a:hover {
    color: var(--accent);
    text-decoration: underline;
  }
  .fine {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 22px;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.06em;
    color: var(--muted);
    margin: var(--space-5) 0 0;
  }
  .fine a {
    color: inherit;
  }
</style>
