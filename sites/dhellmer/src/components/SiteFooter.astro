---
/** Footer as the log's closing line: who keeps it, where, its revision, and the index. */
import { HUB, LINKS, LOCALITY, NAME, NAV, REVISION, ROLE } from "../lib/site";

const year = REVISION.date === "unreleased" ? "2026" : REVISION.date.slice(0, 4);
---

<footer class="ft">
  <div class="wrap">
    <div class="close">
      <div class="who">
        <span class="sig">{NAME}</span>
        <span class="muted">{ROLE} · {LOCALITY}</span>
      </div>
      <nav class="idx" aria-label="Footer">
        <a href="/">Home</a>
        {NAV.map((l) => <a href={l.href}>{l.label}</a>)}
        <a href="/privacy/">Privacy</a>
      </nav>
    </div>
    <p class="fine">
      <span>© {year} {NAME}</span>
      <span>Rev <a href={LINKS.siteSource} rel="noopener">{REVISION.date} · {REVISION.hash}</a></span>
      <span>Self-hosted. No cookies, no trackers.</span>
      <span>Business: <a href={HUB}>hllmr.com</a></span>
    </p>
  </div>
</footer>

<style>
  .ft {
    margin-top: var(--space-9);
    padding-bottom: var(--space-6);
  }
  .close {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: var(--space-5);
    flex-wrap: wrap;
    padding-top: var(--space-5);
    border-top: 1px solid var(--text);
  }
  .who {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .sig {
    font-family: var(--font-display);
    font-style: italic;
    font-variation-settings: "opsz" 72;
    font-weight: 420;
    font-size: 1.7rem;
    line-height: 1.1;
  }
  .muted {
    color: var(--muted);
    font-size: 0.9rem;
  }
  .idx {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 16px;
  }
  .idx a {
    font-size: 0.9rem;
    color: var(--text);
    text-decoration: none;
  }
  .idx a:hover {
    color: var(--accent);
    text-decoration: underline;
  }
  .fine {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 20px;
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.04em;
    color: var(--muted);
    margin: var(--space-4) 0 0;
  }
  .fine a {
    color: inherit;
  }
</style>
