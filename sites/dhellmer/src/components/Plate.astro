---
/**
 * The typographic plate that stands where a portrait would: the "dh" monogram set large in Fraunces
 * italic, hung from the log's margin rule, with a mono caption. Decorative, so it is hidden from
 * assistive technology (the name is the page's heading and the fact list's first entry).
 * Owner decision 2026-10-18: ship with this now; the photograph replaces it in a later release.
 */
interface Props {
  /** Short mono caption under the monogram. */
  caption: string;
}
const { caption } = Astro.props;
---

<div class="plate" aria-hidden="true">
  <span class="glyph">dh</span>
  <span class="caption">{caption}</span>
</div>

<style>
  .plate {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    aspect-ratio: 4 / 5;
    padding: var(--space-5) var(--space-5) var(--space-4) calc(var(--space-5) + 6px);
    background-color: var(--surface);
    background-image: repeating-linear-gradient(
      to bottom,
      transparent 0,
      transparent calc(var(--line) - 1px),
      var(--ruled) calc(var(--line) - 1px),
      var(--ruled) var(--line)
    );
    border: 1px solid var(--rule);
    border-left: 4px solid var(--accent);
    overflow: hidden;
  }
  .glyph {
    font-family: var(--font-display);
    font-style: italic;
    font-variation-settings: "opsz" 144;
    font-weight: 300;
    font-size: clamp(7rem, 4rem + 9vw, 12rem);
    line-height: 0.8;
    letter-spacing: -0.06em;
    color: var(--text);
    margin-top: auto;
    margin-left: -0.04em;
  }
  .caption {
    margin-top: var(--space-5);
    padding-top: var(--space-3);
    border-top: 1px solid var(--rule);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  @media (max-width: 900px) {
    .plate {
      aspect-ratio: auto;
      min-height: 220px;
    }
  }
</style>
