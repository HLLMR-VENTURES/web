{
  "$comment": "upgrade.hllmr.com public URL contract (ADR-0015). Statuses are what deploy/upgrade/nginx.conf answers; 'location' is the exact Location header.",
  "site": "upgrade",
  "entries": [
    {
      "path": "/",
      "status": 200,
      "contains": "Your business deserves more than a website",
      "why": "home; canonical"
    },
    {
      "path": "/index.html",
      "status": 200,
      "contains": "Your business deserves more than a website"
    },
    {
      "path": "/privacy/",
      "status": 200,
      "contains": "No cookies"
    },
    {
      "path": "/privacy",
      "status": 301,
      "location": "/privacy/"
    },
    {
      "path": "/og.png",
      "status": 200
    },
    {
      "path": "/favicon.svg",
      "status": 200,
      "contains": "<svg"
    },
    {
      "path": "/js/theme.js",
      "status": 200
    },
    {
      "path": "/robots.txt",
      "status": 200,
      "contains": "Sitemap: https://upgrade.hllmr.com/sitemap.xml"
    },
    {
      "path": "/sitemap.xml",
      "status": 200,
      "contains": "https://upgrade.hllmr.com/privacy/"
    },
    {
      "path": "/no-such-page/",
      "status": 404,
      "contains": "Not on this site."
    }
  ]
}
