{
  "$comment": "gaming.hllmr.com public URL contract (ADR-0015). Statuses are what deploy/gaming/nginx.conf answers; 'location' is the exact Location header.",
  "site": "gaming",
  "entries": [
    {
      "path": "/",
      "status": 200,
      "contains": "More playing, less fixing",
      "why": "home; canonical"
    },
    {
      "path": "/index.html",
      "status": 200,
      "contains": "More playing, less fixing"
    },
    {
      "path": "/privacy/",
      "status": 200,
      "contains": "No cookies"
    },
    {
      "path": "/privacy",
      "status": 301,
      "location": "/privacy/"
    },
    {
      "path": "/og.png",
      "status": 200
    },
    {
      "path": "/favicon.svg",
      "status": 200,
      "contains": "<svg"
    },
    {
      "path": "/js/theme.js",
      "status": 200
    },
    {
      "path": "/robots.txt",
      "status": 200,
      "contains": "Sitemap: https://gaming.hllmr.com/sitemap.xml"
    },
    {
      "path": "/sitemap.xml",
      "status": 200,
      "contains": "https://gaming.hllmr.com/privacy/"
    },
    {
      "path": "/no-such-page/",
      "status": 404,
      "contains": "Not on this site."
    }
  ]
}
